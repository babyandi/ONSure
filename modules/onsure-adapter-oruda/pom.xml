<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.onsure</groupId>
    <artifactId>onsure-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>onsure-adapter-oruda</artifactId>
  <name>ONSure Optional ORUDA Adapter</name>

  <dependencies>
    <dependency>
      <groupId>io.onsure</groupId>
      <artifactId>onsure-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${maven.multiModuleProjectDirectory}/src/main/java</sourceDirectory>
    <testSourceDirectory>${maven.multiModuleProjectDirectory}/src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>io/onsure/platform/OrudaTargetAdapter.java</include>
            <include>io/onsure/platform/ProductPlatformE2EMain.java</include>
            <include>io/onsure/platform/oruda/**/*.java</include>
          </includes>
          <testIncludes>
            <testInclude>io/onsure/platform/oruda/**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <onsure.repository.root>${maven.multiModuleProjectDirectory}</onsure.repository.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
