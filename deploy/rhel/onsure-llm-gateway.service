[Unit]
Description=ONSure loopback LLM Gateway (nonfinal candidate)
Documentation=file:/opt/onsure/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onsure
Group=onsure
EnvironmentFile=/etc/onsure/onsure.env
WorkingDirectory=/var/lib/onsure
ExecStart=/usr/bin/java --add-modules jdk.httpserver -cp /opt/onsure/app/*:/opt/onsure/lib/* io.onsure.gateway.llm.LlmGatewayMain
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
RemoveIPC=yes
PrivateTmp=yes
PrivateDevices=yes
KeyringMode=private
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/onsure /var/log/onsure

[Install]
WantedBy=multi-user.target
