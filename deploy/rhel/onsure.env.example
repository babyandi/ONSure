# Copy to /etc/onsure/onsure.env, owner root:onsure, mode 0640.
# Generate a distinct 32+ character local API token and store it only in the installed file.
ONSURE_LOCAL_API_PORT=47311
ONSURE_WORKSPACE_ROOT=/var/lib/onsure/workspace
# ONSURE_LOCAL_API_TOKEN is the backward-compatible ADMIN identity and is required.
# Generate distinct 32+ character tokens when optional least-privilege roles are enabled.
# ONSURE_LOCAL_API_VIEWER_TOKEN provides read-only dashboard and evidence access.
# ONSURE_LOCAL_API_OPERATOR_TOKEN permits program registration and isolated validation.
# ONSURE_LOCAL_API_APPROVER_TOKEN only decides Gateway setting requests and must be distinct.

# Generate a distinct 32+ character Gateway token in the installed file.
ONSURE_LLM_GATEWAY_PORT=47312
ONSURE_LLM_EVIDENCE_ROOT=/var/lib/onsure/workspace/.onsure/llm-evidence
ONSURE_LLM_PROVIDER=local-mock
ONSURE_LLM_MODEL=onsure-local-mock-v1
ONSURE_LLM_MOCK_REQUESTS_PER_SECOND=20
ONSURE_LLM_MOCK_COST_PER_TOKEN_MICROS=0
# ONSURE_LLM_GATEWAY_TOKEN is required at runtime.

ONSURE_DB_URL=jdbc:postgresql://127.0.0.1:5432/onsure
ONSURE_DB_USER=onsure
ONSURE_DB_SCHEMA=onsure
# Persist scorecards, every scoring node and Before/After comparisons in the local PostgreSQL DB.
ONSURE_SCORE_STORE=POSTGRESQL
ONSURE_MIGRATION_AUTHORIZED=false
# ONSURE_DB_PASSWORD is required at runtime.
# Ubuntu backup timer defaults; password is read from the same external environment file.
ONSURE_DB_HOST=127.0.0.1
ONSURE_DB_PORT=5432
ONSURE_DB_NAME=onsure
ONSURE_BACKUP_ROOT=/var/lib/onsure/backups
ONSURE_BACKUP_RETENTION_DAYS=14

ONSURE_OPENAI_MODEL=gpt-5.6-sol
# OPENAI_API_KEY is required only when the remote provider is invoked.
# Set current approved token prices explicitly; values are micros per one million tokens.
# ONSURE_OPENAI_INPUT_MICROS_PER_MILLION_TOKENS is required for provider invocation.
# ONSURE_OPENAI_OUTPUT_MICROS_PER_MILLION_TOKENS is required for provider invocation.
