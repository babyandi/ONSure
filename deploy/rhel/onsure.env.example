# Copy to /etc/onsure/onsure.env, owner root:onsure, mode 0640.
# Generate a distinct 32+ character local API token and store it only in the installed file.
ONSURE_LOCAL_API_PORT=47311
ONSURE_WORKSPACE_ROOT=/var/lib/onsure/workspace

ONSURE_DB_URL=jdbc:postgresql://127.0.0.1:5432/onsure
ONSURE_DB_USER=onsure
ONSURE_DB_SCHEMA=onsure
ONSURE_MIGRATION_AUTHORIZED=false
# ONSURE_DB_PASSWORD is required at runtime.

ONSURE_OPENAI_MODEL=gpt-5.6-sol
# OPENAI_API_KEY is required only when the remote provider is invoked.
# Set current approved token prices explicitly; values are micros per one million tokens.
# ONSURE_OPENAI_INPUT_MICROS_PER_MILLION_TOKENS is required for provider invocation.
# ONSURE_OPENAI_OUTPUT_MICROS_PER_MILLION_TOKENS is required for provider invocation.
