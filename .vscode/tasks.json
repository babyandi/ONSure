{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ONSure: Autopilot Start or Resume",
      "type": "shell",
      "command": "python3 scripts/onsure-autopilot.py resume",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "isBackground": false,
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "ONSure: Autopilot Status",
      "type": "shell",
      "command": "python3 scripts/onsure-autopilot.py status",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    {
      "label": "ONSure: Resume After RCA",
      "type": "shell",
      "command": "python3 scripts/onsure-autopilot.py reset-failed && python3 scripts/onsure-autopilot.py resume",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
