{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/offline-trust-bundle.v1.schema.json",
  "title": "ONSure Offline Trust Bundle v1",
  "description": "31_ASSURANCE_CERTIFICATE_OFFLINE_ENTERPRISE_GOVERNANCE.md SS8 (Offline/Air-gapped Assurance). Offline uncertainty grows with time since last sync and must never be hidden: offline_status starts at OFFLINE_CURRENT_WITHIN_GRACE and degrades through OFFLINE_REVALIDATION_DUE -> OFFLINE_STATUS_UNCERTAIN -> OFFLINE_BLOCKED as grace_period_seconds elapses without a Reconnect Reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "bundle_id", "trusted_root_key_ids", "key_registry_snapshot_digest",
    "policy_snapshot_digest", "validator_qualification_snapshot_digest",
    "revocation_snapshot_digest", "trusted_time_evidence", "generated_at", "expires_at",
    "grace_period_seconds", "offline_status", "bundle_signature", "bundle_sha256",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_OFFLINE_TRUST_BUNDLE_V1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "trusted_root_key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "key_registry_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "policy_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "validator_qualification_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "revocation_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "trusted_time_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "trust_level"],
      "properties": {
        "source": {"enum": ["TPM", "SECURE_CLOCK", "ENTERPRISE_TIME_AUTHORITY", "LOCAL_OS_CLOCK_ONLY"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "trust_level": {"enum": ["HIGH", "MEDIUM", "LOW", "UNTRUSTED"]}
      },
      "description": "A single local OS clock alone must not be trusted; source=LOCAL_OS_CLOCK_ONLY caps trust_level at LOW/UNTRUSTED, which caps the freshness ceiling downstream."
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "grace_period_seconds": {"type": "integer", "minimum": 0},
    "last_online_sync_at": {"type": ["string", "null"], "format": "date-time"},
    "offline_status": {
      "enum": ["OFFLINE_CURRENT_WITHIN_GRACE", "OFFLINE_REVALIDATION_DUE", "OFFLINE_STATUS_UNCERTAIN", "OFFLINE_BLOCKED"]
    },
    "bundle_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 32}
      }
    },
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"trusted_time_evidence": {"properties": {"source": {"const": "LOCAL_OS_CLOCK_ONLY"}}}}},
      "then": {"properties": {"trusted_time_evidence": {"properties": {"trust_level": {"enum": ["LOW", "UNTRUSTED"]}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
