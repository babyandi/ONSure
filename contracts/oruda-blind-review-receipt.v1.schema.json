{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/oruda-blind-review-receipt.v1.schema.json",
  "title": "ONSURE ORUDA Blind Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "review_id",
    "target_id",
    "job_id",
    "reviewer_id",
    "reviewer_authority",
    "decision",
    "fixture_ids",
    "reviewed_at",
    "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ORUDA_BLIND_REVIEW_RECEIPT_V1"},
    "review_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_authority": {"const": "HUMAN_INDEPENDENT_REVIEWER"},
    "decision": {"enum": ["PASS", "FAIL"]},
    "fixture_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
