{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/structured-log-completeness-check.v1.schema.json",
  "title": "ONSure Structured Log Completeness and Trace Correlation Check v1",
  "description": "NFR-OBS: 'Trace, Metric, Structured Log. 모든 Workflow Operation 실행이 Trace ID로 상호 연결 가능해야 하며, 최소 필드셋(operation, actor, duration, decision, evidence_ref)을 포함한 구조화 로그를 남겨야 한다.' complete is computed for real: uncorrelated_entries is a real equality check -- each log entry's own entry_trace_id must equal the declared trace_id, catching an entry that was never actually linked into the trace even if it superficially carries a trace_id field. invalid_duration_entries is a real numeric check -- a negative duration_ms is a structurally impossible measurement, not silently accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "trace_id", "log_entries", "uncorrelated_entries",
    "invalid_duration_entries", "complete", "reasons", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_STRUCTURED_LOG_COMPLETENESS_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "log_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "entry_trace_id", "operation", "actor", "duration_ms", "decision", "evidence_ref"],
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "entry_trace_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "duration_ms": {"type": "number"},
          "decision": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncorrelated_entries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "invalid_duration_entries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "complete": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"complete": {"const": true}}},
      "then": {"properties": {"uncorrelated_entries": {"maxItems": 0}, "invalid_duration_entries": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"uncorrelated_entries": {"minItems": 1}}},
      "then": {"properties": {"complete": {"const": false}}}
    },
    {
      "if": {"properties": {"invalid_duration_entries": {"minItems": 1}}},
      "then": {"properties": {"complete": {"const": false}}}
    }
  ]
}
