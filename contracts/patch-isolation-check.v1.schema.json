{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/patch-isolation-check.v1.schema.json",
  "title": "ONSure Automated Patch Isolation Check v1",
  "description": "FR-COM-007: '모든 자동 Patch는 별도 Worktree와 Branch에서 수행한다.' isolated is computed for real: the patch's own worktree path must differ from the main workspace's worktree path, and the patch's branch name must not be one of the caller-declared protected branch names (e.g. main). A patch claiming to be a separate change while actually running in the main worktree or on a protected branch is a real isolation violation, not a caller-declared flag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "patch_id", "patch_worktree_path", "main_worktree_path",
    "patch_branch_name", "protected_branch_names", "worktree_isolated", "branch_isolated",
    "isolated", "reasons", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PATCH_ISOLATION_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "patch_id": {"type": "string", "minLength": 1},
    "patch_worktree_path": {"type": "string", "minLength": 1},
    "main_worktree_path": {"type": "string", "minLength": 1},
    "patch_branch_name": {"type": "string", "minLength": 1},
    "protected_branch_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "worktree_isolated": {"type": "boolean"},
    "branch_isolated": {"type": "boolean"},
    "isolated": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"isolated": {"const": true}}},
      "then": {"properties": {"worktree_isolated": {"const": true}, "branch_isolated": {"const": true}}}
    },
    {
      "if": {"properties": {"worktree_isolated": {"const": false}}},
      "then": {"properties": {"isolated": {"const": false}}}
    },
    {
      "if": {"properties": {"branch_isolated": {"const": false}}},
      "then": {"properties": {"isolated": {"const": false}}}
    }
  ]
}
