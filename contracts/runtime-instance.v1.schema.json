{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/runtime-instance.v1.schema.json",
  "title": "ONSure Runtime Instance v1",
  "description": "29_DEPLOYMENT_RUNTIME_CURRENTNESS_AND_REVOCATION_DESIGN.md SS3.4. A running instance has its own identity separate from the DeploymentRevision record -- health success is not semantic assurance success (SS2). Many RuntimeInstance records aggregate into one runtime-population-snapshot.v1.schema.json for a given DeploymentRevision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "runtime_instance_id", "deployment_revision_id", "process_identity", "boot_id",
    "observed_artifact_digest", "observed_config_digest", "observed_dependency_digest",
    "model_runtime_digest", "prompt_bundle_digest", "rag_runtime_digest",
    "external_contract_set_digest", "first_seen_at", "last_seen_at", "health_state",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_RUNTIME_INSTANCE_V1"},
    "runtime_instance_id": {"type": "string", "minLength": 1},
    "deployment_revision_id": {"type": "string", "minLength": 1},
    "process_identity": {"type": "string", "minLength": 1},
    "boot_id": {"type": "string", "minLength": 1},
    "observed_artifact_digest": {"$ref": "#/$defs/sha256"},
    "observed_config_digest": {"$ref": "#/$defs/sha256"},
    "observed_dependency_digest": {"$ref": "#/$defs/sha256"},
    "model_runtime_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})?$"},
    "prompt_bundle_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})?$"},
    "rag_runtime_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})?$"},
    "external_contract_set_digest": {"$ref": "#/$defs/sha256"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "health_state": {"enum": ["HEALTHY", "DEGRADED", "UNHEALTHY", "UNREACHABLE"]},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
