{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/semantic-assurance-gate-receipt.candidate.v2.schema.json",
  "title": "ONSure Semantic Assurance Gate Receipt Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "gate_receipt_id", "target", "epochs", "evidence_bundle",
    "semantic_capability_closure", "freshness_barrier", "independent_otester",
    "independent_oaudit", "human_acceptance", "open_findings", "revocation",
    "decision", "reason_codes", "reconstructed_at", "authority", "signature",
    "gate_receipt_sha256", "final_lock_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_SEMANTIC_ASSURANCE_GATE_RECEIPT_V2_CANDIDATE"},
    "gate_receipt_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "source_tree_sha256", "artifact_digest"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "deployment_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})$"}
      }
    },
    "epochs": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_epoch", "requirement_epoch", "denominator_epoch", "policy_epoch", "oracle_epoch", "validator_qualification_epoch", "authority_epoch"],
      "properties": {
        "scope_epoch": {"type": "string", "minLength": 1},
        "requirement_epoch": {"type": "string", "minLength": 1},
        "denominator_epoch": {"type": "string", "minLength": 1},
        "policy_epoch": {"type": "string", "minLength": 1},
        "oracle_epoch": {"type": "string", "minLength": 1},
        "validator_qualification_epoch": {"type": "string", "minLength": 1},
        "authority_epoch": {"type": "string", "minLength": 1}
      }
    },
    "evidence_bundle": {"$ref": "#/$defs/typedReceiptRef"},
    "semantic_capability_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable_count", "passed_count", "blocked_count", "hold_count", "not_run_count", "capability_set_digest", "closure_receipts"],
      "properties": {
        "applicable_count": {"type": "integer", "minimum": 0},
        "passed_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0},
        "hold_count": {"type": "integer", "minimum": 0},
        "not_run_count": {"type": "integer", "minimum": 0},
        "capability_set_digest": {"$ref": "#/$defs/sha256"},
        "closure_receipts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityReceiptRef"}}
      }
    },
    "freshness_barrier": {"$ref": "#/$defs/typedReceiptRef"},
    "independent_otester": {"$ref": "#/$defs/independentReceiptRef"},
    "independent_oaudit": {"$ref": "#/$defs/independentReceiptRef"},
    "human_acceptance": {"$ref": "#/$defs/typedReceiptRef"},
    "open_findings": {
      "type": "object", "additionalProperties": false,
      "required": ["p0_count", "p1_count", "blocking_set_digest"],
      "properties": {
        "p0_count": {"type": "integer", "minimum": 0},
        "p1_count": {"type": "integer", "minimum": 0},
        "blocking_set_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "revocation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "revocation_epoch", "current_status_receipt_sha256"],
      "properties": {
        "state": {"enum": ["CURRENT", "STALE", "REVOKED", "INVALIDATED", "STATUS_UNKNOWN", "REASSESSMENT_REQUIRED"]},
        "revocation_epoch": {"type": "string", "minLength": 1},
        "current_status_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {"enum": ["PASS", "BLOCKED", "HOLD", "INCONCLUSIVE"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_:-]{3,160}$"}},
    "reconstructed_at": {"type": "string", "format": "date-time"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_profile_id", "principal_profile_sha256", "authority_epoch"],
      "properties": {
        "principal_profile_id": {"type": "string", "minLength": 1},
        "principal_profile_sha256": {"$ref": "#/$defs/sha256"},
        "authority_epoch": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 32}
      }
    },
    "gate_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "final_lock_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PASS"}}},
      "then": {
        "properties": {
          "semantic_capability_closure": {"properties": {"blocked_count": {"const": 0}, "hold_count": {"const": 0}, "not_run_count": {"const": 0}}},
          "open_findings": {"properties": {"p0_count": {"const": 0}, "p1_count": {"const": 0}}},
          "revocation": {"properties": {"state": {"const": "CURRENT"}}}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "PASS"}}},
      "then": {
        "properties": {
          "independent_otester": {"properties": {"independence_state": {"const": "INDEPENDENT"}, "qualification_state": {"const": "QUALIFIED"}}},
          "independent_oaudit": {"properties": {"independence_state": {"const": "INDEPENDENT"}, "qualification_state": {"const": "QUALIFIED"}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typedReceiptRef": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "receipt_type", "receipt_sha256"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_type": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capabilityReceiptRef": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "applicability", "decision", "receipt_sha256"],
      "properties": {
        "capability_id": {"pattern": "^SA-(?:0[1-9]|1[0-4])$"},
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE_JUSTIFIED"]},
        "decision": {"enum": ["PASS", "FAIL", "BLOCKED", "HOLD", "NOT_RUN", "INCONCLUSIVE"]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "independentReceiptRef": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "receipt_sha256", "principal_profile_sha256", "independence_profile_sha256", "independence_state", "qualification_state"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "principal_profile_sha256": {"$ref": "#/$defs/sha256"},
        "independence_profile_sha256": {"$ref": "#/$defs/sha256"},
        "independence_state": {"enum": ["SELF_VALIDATION", "PARTIAL_INDEPENDENCE", "INDEPENDENT", "COMPROMISED"]},
        "qualification_state": {"enum": ["NOT_QUALIFIED", "PARTIAL", "QUALIFIED_NONFINAL", "QUALIFIED", "STALE", "FAILED"]}
      }
    }
  }
}
