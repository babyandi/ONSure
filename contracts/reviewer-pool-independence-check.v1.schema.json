{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/reviewer-pool-independence-check.v1.schema.json",
  "title": "ONSure Reviewer Pool Independence Check v1",
  "description": "FR-LEARN-061 Reviewer Collusion/Consensus Bias ('동일 조직·지시·모델·자료에 과도하게 의존하거나 상호 영향받으면 독립 review로 계산하지 않는다'), FR-LEARN-062 Evaluator Capture/Authority Concentration ('특정 evaluator, team, model, vendor가 과도하게 독점하지 않도록 concentration metric과 SoD를 적용한다... 임계치를 넘으면 독립 review를 요구한다'), and FR-LEARN-093 External Evaluation/Red-team Independence, reconciled together per 161_LEARNING_VALIDATION_P1_CONTRADICTION_POLICY_BINDINGS.md's own precedence rule: 'pool이 다양성 요건을 충족하지 못하면 요건을 조용히 완화하지 않는다 -- REDUCED_INDEPENDENCE_DISCLOSED 플래그와 실제 중첩 사유를 명시하고, 고위험 결정은 외부 reviewer 추가 확보 전까지 HOLD한다.' A reviewer pair sharing any of org/instruction-source/model/material-source is a real collusion-risk pair, not a caller-declared flag; a max decision-share above the declared threshold is a real authority-capture computation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "decision_risk_tier", "minimum_required_independent_reviewers",
    "concentration_threshold", "reviewers", "collusion_risk_pairs", "independent_reviewer_count",
    "authority_capture_risk", "max_concentration_share", "reduced_independence", "state", "reasons",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_REVIEWER_POOL_INDEPENDENCE_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "decision_risk_tier": {"enum": ["STANDARD", "HIGH_RISK"]},
    "minimum_required_independent_reviewers": {"type": "integer", "minimum": 1},
    "concentration_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "org_id", "instruction_source_id", "model_id", "material_source_id", "decision_share"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "org_id": {"type": "string", "minLength": 1},
          "instruction_source_id": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "minLength": 1},
          "material_source_id": {"type": "string", "minLength": 1},
          "decision_share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "collusion_risk_pairs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "independent_reviewer_count": {"type": "integer", "minimum": 0},
    "authority_capture_risk": {"type": "boolean"},
    "max_concentration_share": {"type": "number", "minimum": 0, "maximum": 1},
    "reduced_independence": {"type": "boolean"},
    "state": {"enum": ["INDEPENDENT_REVIEW_CONFIRMED", "REDUCED_INDEPENDENCE_DISCLOSED", "HOLD"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "INDEPENDENT_REVIEW_CONFIRMED"}}},
      "then": {
        "properties": {
          "reduced_independence": {"const": false},
          "authority_capture_risk": {"const": false},
          "collusion_risk_pairs": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"authority_capture_risk": {"const": true}}},
      "then": {"properties": {"reduced_independence": {"const": true}}}
    },
    {
      "if": {"properties": {"reduced_independence": {"const": true}, "decision_risk_tier": {"const": "HIGH_RISK"}}},
      "then": {"properties": {"state": {"const": "HOLD"}}}
    },
    {
      "if": {"properties": {"reduced_independence": {"const": true}, "decision_risk_tier": {"const": "STANDARD"}}},
      "then": {"properties": {"state": {"const": "REDUCED_INDEPENDENCE_DISCLOSED"}}}
    }
  ]
}
