{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/final-acceptance-population.candidate.v2.schema.json",
  "title": "ONSure Final Acceptance Population Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "population_id", "target_id", "requirement_epoch", "denominator_epoch",
    "source_authority_epoch", "sources", "population_digest", "created_at", "decision",
    "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_FINAL_ACCEPTANCE_POPULATION_V2_CANDIDATE"},
    "population_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "requirement_epoch": {"type": "string", "minLength": 1},
    "denominator_epoch": {"type": "string", "minLength": 1},
    "source_authority_epoch": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_type", "source_sha256", "authority_class", "current", "acceptance_obligations"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["MASTER_REQUIREMENT", "CONTRACT", "POLICY", "SECURITY_PRIVACY", "OPERATION", "RUNTIME_DISCOVERY", "RIGHTS_REMEDY", "EXTERNAL_NORMATIVE"]},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "authority_class": {"type": "string", "minLength": 1},
          "current": {"type": "boolean"},
          "supersedes_source_id": {"type": ["string", "null"]},
          "acceptance_obligations": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "population_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["NON_FINAL", "HOLD", "BLOCKED"]},
    "final_claim_allowed": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
