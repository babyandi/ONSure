{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/federated-aggregation-governance-check.v1.schema.json",
  "title": "ONSure Federated Aggregation Governance Check v1",
  "description": "FR-LEARN-053 Federated Learning/Aggregation Governance, reconciled with FR-COM-002 Tenant Isolation and FR-LEARN-046 Cross-Tenant Transfer Risk per 161_LEARNING_VALIDATION_P1_CONTRADICTION_POLICY_BINDINGS.md contradiction #1's own precedence rule: federated aggregation is a distinct mechanism from asset-promotion lineage/consent (158 CLASS 4) -- it aggregates signals from multiple tenants concurrently without a promotion event, and the aggregate itself can structurally leak individual tenant information (e.g. an outlier tenant's gradient characteristics). Precedence: a cohort below the declared minimum size, or an aggregation dominated by one outlier contributor, is REJECTED fail-closed; every aggregation round requires each participating tenant's explicit opt-in for THAT round, never substituted by a separate asset-promotion consent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "aggregation_round_id", "min_cohort_size",
    "outlier_dominance_threshold", "participants", "cohort_size", "cohort_too_small",
    "max_contribution_weight", "outlier_dominant", "non_opted_in_tenants", "state", "reasons",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_FEDERATED_AGGREGATION_GOVERNANCE_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "aggregation_round_id": {"type": "string", "minLength": 1},
    "min_cohort_size": {"type": "integer", "minimum": 1},
    "outlier_dominance_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id", "opt_in", "contribution_weight"],
        "properties": {
          "tenant_id": {"type": "string", "minLength": 1},
          "opt_in": {"type": "boolean"},
          "contribution_weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "cohort_size": {"type": "integer", "minimum": 0},
    "cohort_too_small": {"type": "boolean"},
    "max_contribution_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "outlier_dominant": {"type": "boolean"},
    "non_opted_in_tenants": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "state": {"enum": ["AGGREGATION_AUTHORIZED", "REJECTED"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "AGGREGATION_AUTHORIZED"}}},
      "then": {
        "properties": {
          "cohort_too_small": {"const": false},
          "outlier_dominant": {"const": false},
          "non_opted_in_tenants": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"cohort_too_small": {"const": true}}},
      "then": {"properties": {"state": {"const": "REJECTED"}}}
    },
    {
      "if": {"properties": {"outlier_dominant": {"const": true}}},
      "then": {"properties": {"state": {"const": "REJECTED"}}}
    },
    {
      "if": {"properties": {"non_opted_in_tenants": {"minItems": 1}}},
      "then": {"properties": {"state": {"const": "REJECTED"}}}
    }
  ]
}
