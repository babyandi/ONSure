{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/oruda-package-execution-registry.v1.schema.json",
  "title": "ONSURE ORUDA Package Execution Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "target_id",
    "job_id",
    "generated_at",
    "catalog_sha256",
    "packages"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ORUDA_PACKAGE_EXECUTION_REGISTRY_V1"},
    "target_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "status",
          "reason",
          "output_receipts",
          "package_digest"
        ],
        "properties": {
          "package_id": {"type": "string", "pattern": "^ORU-PKG-[0-9]{2}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
          "reason": {"type": "string", "minLength": 1},
          "output_receipts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "output_id",
                "relative_path",
                "receipt_sha256",
                "decision",
                "evidence_path",
                "evidence_sha256",
                "semantic_digest"
              ],
              "properties": {
                "output_id": {"type": "string", "minLength": 1},
                "relative_path": {"type": "string", "minLength": 1},
                "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "decision": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
                "evidence_path": {"type": "string", "minLength": 1},
                "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
