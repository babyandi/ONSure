{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/learning-authority-domain-separation-check.v1.schema.json",
  "title": "ONSure Learning Authority Domain Separation Check v1",
  "description": "FR-LEARN-001: 'ONSure는 Target/Assurance/Validator Learning을 별도 authority domain으로 구분해야 한다.' separation_valid is computed for real at two levels: domain_authorized is a real membership check that the deciding authority's own declared domain scope actually includes the candidate's learning_domain (an authority never granted TARGET_LEARNING scope cannot decide a TARGET_LEARNING candidate). cross_domain_authority is a real cardinality check -- an authority whose own domain_scope spans more than one of the three domains is itself not properly separated, regardless of which specific decision it is making, since true separation means no single authority holds decision power across domains at all.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "candidate_id", "learning_domain", "decision_authority_id",
    "decision_authority_domain_scope", "domain_authorized", "cross_domain_authority",
    "separation_valid", "reasons", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_LEARNING_AUTHORITY_DOMAIN_SEPARATION_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "learning_domain": {"enum": ["TARGET_LEARNING", "ASSURANCE_LEARNING", "VALIDATOR_LEARNING"]},
    "decision_authority_id": {"type": "string", "minLength": 1},
    "decision_authority_domain_scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["TARGET_LEARNING", "ASSURANCE_LEARNING", "VALIDATOR_LEARNING"]}
    },
    "domain_authorized": {"type": "boolean"},
    "cross_domain_authority": {"type": "boolean"},
    "separation_valid": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"separation_valid": {"const": true}}},
      "then": {"properties": {"domain_authorized": {"const": true}, "cross_domain_authority": {"const": false}}}
    },
    {
      "if": {"properties": {"domain_authorized": {"const": false}}},
      "then": {"properties": {"separation_valid": {"const": false}}}
    },
    {
      "if": {"properties": {"cross_domain_authority": {"const": true}}},
      "then": {"properties": {"separation_valid": {"const": false}}}
    }
  ]
}
