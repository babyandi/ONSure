{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/assurance-subject-graph.v1.schema.json",
  "title": "ONSure Assurance Subject Graph v1",
  "description": "71_MACHINE_CONTRACT_FIELD_BY_FIELD_SPEC.md SS3. The dependency graph among assurance subjects (components/products/services) that assurance-composition-snapshot.v1.schema.json rolls up. Distinct object from evidence-graph-snapshot.v1.schema.json (Wave 2): that graph tracks EVIDENCE lineage (findings, patches), this graph tracks SUBJECT composition (what depends on what).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "graph_id", "graph_generation", "product_subject_id",
    "subject_population_digest", "edge_population_digest", "graph_head_digest",
    "nodes", "edges", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ASSURANCE_SUBJECT_GRAPH_V1"},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_generation": {"type": "integer", "minimum": 1},
    "product_subject_id": {"type": "string", "minLength": 1},
    "subject_population_digest": {"$ref": "#/$defs/sha256"},
    "edge_population_digest": {"$ref": "#/$defs/sha256"},
    "graph_head_digest": {"$ref": "#/$defs/sha256"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "subject_digest", "tenant_id"],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1},
          "subject_digest": {"$ref": "#/$defs/sha256"},
          "tenant_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "source_subject_id", "source_digest", "target_subject_id", "target_digest", "dependency_type", "propagation_class", "affected_claim_ids", "condition_ref"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "source_subject_id": {"type": "string", "minLength": 1},
          "source_digest": {"$ref": "#/$defs/sha256"},
          "target_subject_id": {"type": "string", "minLength": 1},
          "target_digest": {"$ref": "#/$defs/sha256"},
          "dependency_type": {"enum": ["DERIVED_FROM", "SUPERSEDES", "COMPOSED_OF", "DEPENDS_ON"]},
          "propagation_class": {"enum": ["HARD", "SOFT", "CONDITIONAL", "INFORMATIONAL"]},
          "affected_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "condition_ref": {"type": ["string", "null"]}
        }
      }
    },
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
