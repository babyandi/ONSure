{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.dev/contracts/ground-truth-producer-qualification.candidate.v2.schema.json",
  "title":"ONSure Ground Truth Producer Qualification Candidate v2",
  "type":"object",
  "additionalProperties":false,
  "required":["contract","ground_truth_id","ground_truth_epoch","grade","producer_type","producer_id","producer_implementation_sha256","oracle_sha256","target_code_dependency","calibration_receipts","known_failure_modes","validity_scope","valid_from","valid_until","qualification_state","qualification_sha256"],
  "properties":{
    "contract":{"const":"ONSURE_GROUND_TRUTH_PRODUCER_QUALIFICATION_V2_CANDIDATE"},
    "ground_truth_id":{"type":"string","minLength":1},
    "ground_truth_epoch":{"type":"string","minLength":1},
    "grade":{"enum":["GT0_UNKNOWN","GT1_CORROBORATED","GT2_INDEPENDENT_TOOL","GT3_EXECUTABLE_ORACLE","GT4_EXPERT_VERIFIED","GT5_REAL_WORLD_OBSERVED"]},
    "producer_type":{"enum":["HUMAN","TOOL","ORACLE","REAL_WORLD_OBSERVATION"]},
    "producer_id":{"type":"string","minLength":1},
    "producer_implementation_sha256":{"$ref":"#/$defs/sha256"},
    "oracle_sha256":{"$ref":"#/$defs/sha256"},
    "target_code_dependency":{"enum":["NONE","PARTIAL","SHARED"]},
    "calibration_receipts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}},
    "known_failure_modes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "validity_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "qualification_state":{"enum":["NOT_QUALIFIED","PARTIAL","QUALIFIED_NONFINAL","QUALIFIED","STALE","FAILED"]},
    "qualification_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
