{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/oruda-harness-command-manifest.v1.schema.json",
  "title": "ONSURE ORUDA Harness Command Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "target_id",
    "harness_id",
    "working_directory",
    "allowed_executables",
    "network_policy",
    "created_at",
    "entries"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ORUDA_HARNESS_COMMAND_MANIFEST_V1"},
    "target_id": {"type": "string", "minLength": 1},
    "harness_id": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "allowed_executables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["bash"]}
    },
    "network_policy": {"const": "DENY_BY_DEFAULT"},
    "created_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "command",
          "timeout_seconds",
          "oracle_id",
          "expected_result",
          "expected_exit_codes",
          "output_parser",
          "environment_keys",
          "receipt_binding"
        ],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
          "oracle_id": {"type": "string", "minLength": 1},
          "expected_result": {"type": "string"},
          "expected_exit_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "output_parser": {"const": "UTF8_STDOUT_STRIP"},
          "environment_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^ONSURE_FIXTURE_[A-Z0-9_]{1,64}$"}
          },
          "receipt_binding": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMMAND",
                "TIMEOUT",
                "EXIT_CODE",
                "TIMED_OUT",
                "OUTPUT_SHA256",
                "ORACLE_ID",
                "EXPECTED_RESULT",
                "ACTUAL_RESULT"
              ]
            }
          }
        }
      }
    }
  }
}
