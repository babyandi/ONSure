{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/oracle-qualification.v1.schema.json",
  "title": "ONSure Oracle Qualification v1",
  "description": "149_LEARNING_VALIDATION_SCHEMA_FIXTURE_SPECIFICATION.md SS E. 148 P0 invariant 4: an unqualified or stale oracle must never be used for a final PASS. result=QUALIFIED requires independent=true and fresh_until in the future relative to qualified_at -- both enforced structurally below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "oracle_id", "oracle_version", "oracle_hash", "expected_result_authority_ref",
    "benchmark_refs", "independent", "result", "qualified_at", "fresh_until"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ORACLE_QUALIFICATION_V1"},
    "oracle_id": {"type": "string", "minLength": 1},
    "oracle_version": {"type": "string", "minLength": 1},
    "oracle_hash": {"$ref": "#/$defs/sha256"},
    "expected_result_authority_ref": {"type": "string", "minLength": 1},
    "benchmark_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "independent": {"type": "boolean"},
    "result": {"enum": ["NOT_QUALIFIED", "QUALIFICATION_PENDING", "QUALIFIED", "STALE", "REVOKED"]},
    "qualified_at": {"type": ["string", "null"], "format": "date-time"},
    "fresh_until": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "QUALIFIED"}}},
      "then": {
        "required": ["qualified_at", "fresh_until"],
        "properties": {
          "independent": {"const": true},
          "qualified_at": {"type": "string"},
          "fresh_until": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"independent": {"const": false}}},
      "then": {"properties": {"result": {"enum": ["NOT_QUALIFIED", "QUALIFICATION_PENDING"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
