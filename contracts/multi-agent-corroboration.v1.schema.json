{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/multi-agent-corroboration.v1.schema.json",
  "title": "ONSure Multi-Agent Corroboration v1",
  "description": "34_AI_RUNTIME_MULTI_AGENT_AND_ONSURE_META_ASSURANCE_EXTENSION.md SS9.4/9.5. N agents reaching the same conclusion is corroboration, never Ground Truth -- agreement_strength is capped below INDEPENDENT_GROUND_TRUTH whenever two or more agents share any of model/provider/prompt/oracle/knowledge_source (a common-mode failure risk), regardless of how many agents agree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "corroboration_id", "subject_id", "agent_conclusions",
    "common_mode_risk", "shared_dependency_axes", "agreement_strength", "evaluated_at"
  ],
  "properties": {
    "contract": {"const": "ONSURE_MULTI_AGENT_CORROBORATION_V1"},
    "corroboration_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "agent_conclusions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent_id", "conclusion", "model_id", "provider_id", "prompt_digest", "oracle_id", "knowledge_source_id"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "conclusion": {"enum": ["PASS", "FAIL", "BLOCKED", "HOLD", "NOT_RUN", "INCONCLUSIVE"]},
          "model_id": {"type": "string", "minLength": 1},
          "provider_id": {"type": "string", "minLength": 1},
          "prompt_digest": {"type": "string", "minLength": 1},
          "oracle_id": {"type": "string", "minLength": 1},
          "knowledge_source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "common_mode_risk": {"type": "boolean"},
    "shared_dependency_axes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "agreement_strength": {"enum": ["NONE", "CORROBORATION_ONLY", "INDEPENDENT_GROUND_TRUTH"]},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"common_mode_risk": {"const": true}}},
      "then": {"properties": {"agreement_strength": {"enum": ["NONE", "CORROBORATION_ONLY"]}}}
    }
  ]
}
