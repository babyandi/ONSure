{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/human-design-authority-decision/v1",
  "type":"object",
  "required":["contract","decision_id","subject_ids","reviewer_principal","review_authority","decided_at","source_digests","decision","rationale","receipt_digest"],
  "properties":{
    "contract":{"const":"ONSURE_HUMAN_DESIGN_AUTHORITY_DECISION_V1"},
    "decision_id":{"type":"string","minLength":1},
    "subject_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "reviewer_principal":{"type":"string","minLength":1},
    "review_authority":{"type":"string","minLength":1},
    "decided_at":{"type":"string","format":"date-time"},
    "source_digests":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "decision":{"enum":["APPROVE_POLICY","APPROVE_WITH_CONDITIONS","REJECT","HOLD"]},
    "rationale":{"type":"string","minLength":1},
    "conditions":{"type":"array","items":{"type":"string"}},
    "receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":true
}
