{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/improvement-proof.v1.schema.json",
  "title": "ONSure Improvement Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "proof_id", "target_id", "patch_apply_receipt_sha256",
    "baseline_report_sha256", "current_report_sha256", "baseline_job_id", "current_job_id",
    "baseline_context_sha256", "current_context_sha256", "context_same", "source_changed",
    "resolved_finding_fingerprints", "new_finding_fingerprints", "unchanged_finding_fingerprints",
    "focused_fixture_validation", "full_regression", "decision", "reasons",
    "independent_otester", "independent_oaudit", "commit_allowed", "created_at",
    "final_claim_allowed", "proof_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_IMPROVEMENT_PROOF_V1"},
    "proof_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "patch_apply_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_report_sha256": {"$ref": "#/$defs/sha256"},
    "current_report_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_job_id": {"type": "string", "minLength": 1},
    "current_job_id": {"type": "string", "minLength": 1},
    "baseline_context_sha256": {"$ref": "#/$defs/sha256"},
    "current_context_sha256": {"$ref": "#/$defs/sha256"},
    "context_same": {"type": "boolean"},
    "source_changed": {"type": "boolean"},
    "resolved_finding_fingerprints": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "new_finding_fingerprints": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "unchanged_finding_fingerprints": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "focused_fixture_validation": {"enum": ["PASS", "FAIL"]},
    "full_regression": {"enum": ["PASS", "FAIL"]},
    "decision": {"enum": ["IMPROVEMENT_PROVEN", "NO_MEANINGFUL_IMPROVEMENT", "REGRESSION_DETECTED", "INCONCLUSIVE"]},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "independent_otester": {"enum": ["NOT_RUN", "PASS", "FAIL", "HOLD"]},
    "independent_oaudit": {"enum": ["NOT_RUN", "PASS", "FAIL", "HOLD"]},
    "commit_allowed": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "final_claim_allowed": {"const": false},
    "proof_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}