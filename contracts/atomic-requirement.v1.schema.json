{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/atomic-requirement.v1.schema.json",
  "title": "ONSure Atomic Requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id", "source_document", "source_locator", "normative_text",
    "requirement_type", "priority", "acceptance_criteria", "design_refs",
    "contract_refs", "code_symbols", "test_methods", "evidence_refs",
    "implementation_status", "verification_status"
  ],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^ONS-[A-Z0-9-]{4,96}$"},
    "source_document": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "normative_text": {"type": "string", "minLength": 1},
    "requirement_type": {
      "enum": ["FUNCTIONAL", "NON_FUNCTIONAL", "SECURITY", "DATA", "UI_UX", "OPERATIONS", "COMMERCIAL", "GOVERNANCE", "TEST_ACCEPTANCE"]
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "text", "oracle", "required_evidence_types"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "oracle": {"type": "string", "minLength": 1},
          "required_evidence_types": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "design_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "contract_refs": {"type": "array", "items": {"type": "string"}},
    "code_symbols": {"type": "array", "items": {"type": "string"}},
    "test_methods": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "implementation_status": {"enum": ["IMPLEMENTED", "PARTIAL", "STUB", "DESIGN_ONLY", "BLOCKED", "DEPRECATED"]},
    "verification_status": {"enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "NOT_RUN", "INCONCLUSIVE", "NON_FINAL"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
