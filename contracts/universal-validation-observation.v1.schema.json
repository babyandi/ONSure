{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/universal-validation-observation.v1.schema.json",
  "title": "ONSure Universal Validation Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "target_id", "source_commit", "profile_id", "assurance_class", "decision",
    "phase_outcomes", "verification_group_outcomes", "not_run_reasons", "source_digest",
    "snapshot_digest", "source_mutation_detected", "environment_sha256", "result_sha256",
    "finalization_sha256", "verified_pass_step_count", "steps", "production_authority",
    "final_claim_allowed", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_UNIVERSAL_VALIDATION_OBSERVATION_V1"},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "assurance_class": {"const": "SELF_VALIDATION_NONFINAL"},
    "decision": {"$ref": "#/$defs/outcome"},
    "phase_outcomes": {"$ref": "#/$defs/phaseOutcomes"},
    "verification_group_outcomes": {"$ref": "#/$defs/groupOutcomes"},
    "not_run_reasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "source_digest": {"$ref": "#/$defs/sha256"},
    "snapshot_digest": {"$ref": "#/$defs/sha256"},
    "source_mutation_detected": {"const": false},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "finalization_sha256": {"$ref": "#/$defs/sha256"},
    "verified_pass_step_count": {"type": "integer", "minimum": 0},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id", "phase", "kind", "required", "outcome", "exit_code", "output_sha256",
          "environment_sha256", "output_truncated", "reason", "started_at", "completed_at"
        ],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "phase": {"enum": ["STRUCTURE_STATIC", "COMPONENT_AND_NEGATIVE", "END_TO_END_LINEAGE", "OPERATIONAL_RESILIENCE"]},
          "kind": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "outcome": {"$ref": "#/$defs/outcome"},
          "exit_code": {"type": "integer"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "environment_sha256": {"$ref": "#/$defs/sha256"},
          "output_truncated": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "production_authority": {"const": false},
    "final_claim_allowed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["PASS_NONFINAL", "FAIL", "BLOCKED", "NOT_RUN", "INCONCLUSIVE"]},
    "phaseOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STRUCTURE_STATIC", "COMPONENT_AND_NEGATIVE", "END_TO_END_LINEAGE", "OPERATIONAL_RESILIENCE"],
      "properties": {
        "STRUCTURE_STATIC": {"$ref": "#/$defs/outcome"},
        "COMPONENT_AND_NEGATIVE": {"$ref": "#/$defs/outcome"},
        "END_TO_END_LINEAGE": {"$ref": "#/$defs/outcome"},
        "OPERATIONAL_RESILIENCE": {"$ref": "#/$defs/outcome"}
      }
    },
    "groupOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ENVIRONMENT_DEPENDENCY", "STRUCTURE", "VALIDATOR_META", "STAGE_FUNCTIONAL",
        "CONNECTED_E2E", "EVIDENCE_DECISION", "OPERATIONS_RECOVERY"
      ],
      "properties": {
        "ENVIRONMENT_DEPENDENCY": {"$ref": "#/$defs/outcome"},
        "STRUCTURE": {"$ref": "#/$defs/outcome"},
        "VALIDATOR_META": {"$ref": "#/$defs/outcome"},
        "STAGE_FUNCTIONAL": {"$ref": "#/$defs/outcome"},
        "CONNECTED_E2E": {"$ref": "#/$defs/outcome"},
        "EVIDENCE_DECISION": {"$ref": "#/$defs/outcome"},
        "OPERATIONS_RECOVERY": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}
