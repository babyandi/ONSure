{
  "contract": "ONSURE_CORE_EXTENSION_BOUNDARY_V1",
  "version": "1.0.0",
  "core": {
    "must_run_without_target_specific_adapter": true,
    "required_packages": [
      "kr.co.oruda.onsure.platform",
      "kr.co.oruda.onsure.assurance",
      "kr.co.oruda.onsure.harness",
      "kr.co.oruda.onsure.learning",
      "kr.co.oruda.onsure.rag"
    ],
    "required_capabilities": [
      "GENERIC_TARGET_REGISTRATION",
      "SOURCE_LOCK",
      "FIXTURE_EXECUTION",
      "EVIDENCE_PERSISTENCE",
      "NONFINAL_DECISION",
      "LEARNING_CANDIDATE_GOVERNANCE"
    ],
    "forbidden_dependencies": [
      "ORUDA_REPOSITORY_PATH",
      "ORUDA_RUNTIME",
      "ORUDA_POLICY_AUTHORITY",
      "ORUDA_FIXTURE_REQUIRED_FOR_CORE_PREFLIGHT"
    ]
  },
  "optional_adapters": [
    {
      "adapter_id": "ORUDA_V1",
      "package_prefix": "kr.co.oruda.onsure.platform.oruda",
      "preflight_profile": "oruda",
      "required_for_core": false,
      "may_write_onsure_final_decision": false
    }
  ],
  "preflight_profiles": {
    "core": {
      "default": true,
      "requires_optional_adapters": []
    },
    "oruda": {
      "default": false,
      "requires_optional_adapters": ["ORUDA_V1"]
    }
  }
}
