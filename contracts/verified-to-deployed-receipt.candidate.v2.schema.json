{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.dev/contracts/verified-to-deployed-receipt.candidate.v2.schema.json",
  "title":"ONSure Verified-to-Deployed Receipt Candidate v2",
  "type":"object","additionalProperties":false,
  "required":["contract","receipt_id","target_id","verified_artifact_digest","deployment","readback","environment","authority","decision","reason_codes","created_at","signature","receipt_sha256"],
  "properties":{
    "contract":{"const":"ONSURE_VERIFIED_TO_DEPLOYED_RECEIPT_V2_CANDIDATE"},"receipt_id":{"type":"string","minLength":1},"target_id":{"type":"string","minLength":1},"verified_artifact_digest":{"$ref":"#/$defs/sha256"},
    "deployment":{"type":"object","additionalProperties":false,"required":["deployment_id","provider","environment_id","expected_artifact_digest","deployment_receipt_sha256"],"properties":{"deployment_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"environment_id":{"type":"string","minLength":1},"expected_artifact_digest":{"$ref":"#/$defs/sha256"},"deployment_receipt_sha256":{"$ref":"#/$defs/sha256"}}},
    "readback":{"type":"object","additionalProperties":false,"required":["actual_artifact_digest","readback_method","readback_receipt_sha256"],"properties":{"actual_artifact_digest":{"$ref":"#/$defs/sha256"},"readback_method":{"type":"string","minLength":1},"readback_receipt_sha256":{"$ref":"#/$defs/sha256"}}},
    "environment":{"type":"object","additionalProperties":false,"required":["environment_digest","policy_epoch","config_digest"],"properties":{"environment_digest":{"$ref":"#/$defs/sha256"},"policy_epoch":{"type":"string","minLength":1},"config_digest":{"$ref":"#/$defs/sha256"}}},
    "authority":{"type":"object","additionalProperties":false,"required":["principal_profile_sha256","authority_epoch","purpose"],"properties":{"principal_profile_sha256":{"$ref":"#/$defs/sha256"},"authority_epoch":{"type":"string","minLength":1},"purpose":{"const":"DEPLOYMENT_VERIFICATION"}}},
    "decision":{"enum":["PASS","FAIL","BLOCKED","HOLD","INCONCLUSIVE"]},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"created_at":{"type":"string","format":"date-time"},
    "signature":{"type":"object","additionalProperties":false,"required":["key_id","algorithm","signature"],"properties":{"key_id":{"type":"string","minLength":1},"algorithm":{"const":"Ed25519"},"signature":{"type":"string","minLength":32}}},"receipt_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
