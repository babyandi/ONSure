{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/dd-semantic-runtime-evidence/v1",
  "title":"ONSure DD Semantic Runtime Evidence Receipt",
  "type":"object",
  "required":["contract","dd_id","operation","source_tree_sha","target_identity","execution_principal","execution_environment","evaluator_id","evaluator_version","qualification_receipt_digest","input_evidence","result","executed_at","receipt_digest","synthetic_fixture","github_actions_authority","final_claim_allowed"],
  "properties":{
    "contract":{"const":"ONSURE_DD_SEMANTIC_RUNTIME_EVIDENCE_V1"},
    "dd_id":{"type":"string","pattern":"^DD-(00[1-9]|0[1-3][0-9]|040)$"},
    "operation":{"type":"string","minLength":1},
    "source_tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "target_identity":{"type":"string","minLength":1},
    "execution_principal":{"type":"string","minLength":1},
    "execution_environment":{"type":"string","minLength":1},
    "evaluator_id":{"type":"string","minLength":1},
    "evaluator_version":{"type":"string","minLength":1},
    "qualification_receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "input_evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["evidence_ref","content_digest","integrity_verified","current"],"properties":{"evidence_ref":{"type":"string","minLength":1},"content_digest":{"type":"string","minLength":1},"integrity_verified":{"const":true},"current":{"const":true}},"additionalProperties":true}},
    "result":{"type":"object","required":["decision","blocking_reasons","evidence_receipt_refs","claim_strengthening_allowed","external_effect_performed","final_claim_allowed"],"properties":{"decision":{"enum":["PASS_NONFINAL","HOLD","FAIL","BLOCKED","INCONCLUSIVE","NOT_RUN"]},"blocking_reasons":{"type":"array","items":{"type":"string"}},"evidence_receipt_refs":{"type":"array","items":{"type":"string"}},"claim_strengthening_allowed":{"type":"boolean"},"external_effect_performed":{"type":"boolean"},"final_claim_allowed":{"const":false}},"additionalProperties":true},
    "executed_at":{"type":"string","format":"date-time"},
    "receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "synthetic_fixture":{"const":false},
    "github_actions_authority":{"const":false},
    "final_claim_allowed":{"const":false}
  },
  "additionalProperties":true
}
