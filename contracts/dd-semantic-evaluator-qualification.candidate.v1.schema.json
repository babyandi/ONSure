{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/dd-semantic-evaluator-qualification/v1",
  "title":"ONSure DD Semantic Evaluator Qualification Receipt",
  "type":"object",
  "required":[
    "contract","dd_id","evaluator_id","evaluator_version","evaluator_artifact_sha256",
    "source_tree_sha","obligation_registry_sha256","policy_authority_digests",
    "qualification_principal","qualification_process_lineage","independence_attestation",
    "fixture_results","positive_oracle_refs","qualified_at","expires_at","decision","receipt_digest",
    "final_claim_allowed"
  ],
  "properties":{
    "contract":{"const":"ONSURE_DD_SEMANTIC_EVALUATOR_QUALIFICATION_V1"},
    "dd_id":{"type":"string","pattern":"^DD-(00[1-9]|0[1-3][0-9]|040)$"},
    "evaluator_id":{"type":"string","minLength":1},
    "evaluator_version":{"type":"string","minLength":1},
    "evaluator_artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "obligation_registry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_authority_digests":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uniqueItems":true},
    "qualification_principal":{"type":"string","minLength":1},
    "qualification_process_lineage":{"type":"string","minLength":1},
    "independence_attestation":{
      "type":"object",
      "required":["independent_from_evaluator_authoring","independent_from_target_claim_author","common_control_disclosed"],
      "properties":{
        "independent_from_evaluator_authoring":{"const":true},
        "independent_from_target_claim_author":{"const":true},
        "common_control_disclosed":{"const":true},
        "common_control_details":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "fixture_results":{
      "type":"object",
      "required":["positive","negative","recovery","adversarial"],
      "properties":{
        "positive":{"$ref":"#/$defs/fixtureClass"},
        "negative":{"$ref":"#/$defs/fixtureClass"},
        "recovery":{"$ref":"#/$defs/fixtureClass"},
        "adversarial":{"$ref":"#/$defs/fixtureClass"}
      },
      "additionalProperties":false
    },
    "positive_oracle_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "false_positive_rate":{"type":"number","minimum":0,"maximum":1},
    "false_negative_rate":{"type":"number","minimum":0,"maximum":1},
    "qualification_limitations":{"type":"array","items":{"type":"string"}},
    "qualified_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "decision":{"enum":["QUALIFIED_NONFINAL","REJECTED","HOLD"]},
    "receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "final_claim_allowed":{"const":false}
  },
  "$defs":{
    "fixtureClass":{
      "type":"object",
      "required":["executed_count","passed_count","failed_count","evidence_refs"],
      "properties":{
        "executed_count":{"type":"integer","minimum":1},
        "passed_count":{"type":"integer","minimum":0},
        "failed_count":{"type":"integer","minimum":0},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
