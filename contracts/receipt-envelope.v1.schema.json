{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/receipt-envelope.v1.schema.json",
  "title": "ONSURE ReceiptEnvelope Java Contract v1",
  "description": "Exact JSON shape of io.onsure.assurance.ReceiptEnvelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "receiptType",
    "authority",
    "workspaceId",
    "subjectCommitSha",
    "policyDigest",
    "permitId",
    "previousState",
    "nextState",
    "decision",
    "issuedAt",
    "inputDigests",
    "outputDigests",
    "claims",
    "keyId",
    "signature",
    "selfHash"
  ],
  "properties": {
    "receiptId": {"type": "string", "minLength": 1, "maxLength": 128},
    "receiptType": {
      "type": "string",
      "enum": [
        "SOURCE", "REQUIREMENT", "ARCHITECTURE", "DESIGN", "CODE_REVIEW",
        "SECURITY", "REMEDIATION_PLAN", "PATCH", "OMAKER_PLAN", "OBUILDER_BUILD",
        "RUNTIME", "REGRESSION", "OTESTER", "OAUDIT", "PUBLICATION"
      ]
    },
    "authority": {"type": "string", "minLength": 1},
    "workspaceId": {"type": "string", "minLength": 1},
    "subjectCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policyDigest": {"$ref": "#/$defs/sha256"},
    "permitId": {"type": "string", "minLength": 1},
    "previousState": {"type": "string", "minLength": 1},
    "nextState": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "NOT_RUN", "INCONCLUSIVE"]},
    "issuedAt": {"type": "string", "format": "date-time"},
    "inputDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "outputDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "claims": {"type": "object", "additionalProperties": true},
    "keyId": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "selfHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
