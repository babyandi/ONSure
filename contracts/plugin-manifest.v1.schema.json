{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/plugin-manifest.v1.schema.json",
  "title": "ONSure Plugin Manifest v1",
  "description": "77_EXTERNAL_PLUGIN_AI_META_ASSURANCE_FINAL_SPEC.md SS5. Unsigned/revoked publisher forbids execution; an undeclared privilege must block execution and raise a security event; any artifact digest change requires requalification. A plugin result alone can never create independent Final assurance -- qualification_state here feeds evidence, it is not itself a Final claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "plugin_id", "plugin_version", "publisher_principal_id",
    "publisher_signature_valid", "artifact_digest", "artifact_signature", "capabilities",
    "supported_target_archetypes", "required_privileges", "access_declarations",
    "input_output_contract_refs", "sandbox_profile_id", "qualification_state",
    "qualification_expires_at", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PLUGIN_MANIFEST_V1"},
    "plugin_id": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "publisher_principal_id": {"type": "string", "minLength": 1},
    "publisher_signature_valid": {"type": "boolean"},
    "publisher_revoked": {"type": "boolean", "default": false},
    "artifact_digest": {"$ref": "#/$defs/sha256"},
    "artifact_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 32}
      }
    },
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "supported_target_archetypes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_privileges": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "access_declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "tool_invocation"],
      "properties": {
        "filesystem": {"enum": ["NONE", "READ_ONLY_SANDBOX", "READ_WRITE_SANDBOX"]},
        "network": {"enum": ["NONE", "EGRESS_ALLOWLIST_ONLY", "UNRESTRICTED"]},
        "tool_invocation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "input_output_contract_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sandbox_profile_id": {"type": "string", "minLength": 1},
    "qualification_state": {"enum": ["NOT_QUALIFIED", "QUALIFICATION_PENDING", "QUALIFIED", "STALE", "REVOKED"]},
    "qualification_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"publisher_signature_valid": {"const": false}}},
      "then": {"properties": {"qualification_state": {"enum": ["NOT_QUALIFIED", "REVOKED"]}}}
    },
    {
      "if": {"properties": {"publisher_revoked": {"const": true}}},
      "then": {"properties": {"qualification_state": {"const": "REVOKED"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
