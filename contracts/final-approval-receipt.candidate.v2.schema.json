{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/final-approval-receipt.candidate.v2.schema.json",
  "title": "ONSure Final Approval Receipt Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","approval_id","gate_receipt_id","gate_receipt_sha256","target_id","target_artifact_sha256","principal_profile_id","principal_profile_sha256","authority_epoch","nonce","approved_at","expires_at","decision","reason_codes","signature","approval_sha256","final_lock_authorized"],
  "properties": {
    "contract": {"const": "ONSURE_FINAL_APPROVAL_RECEIPT_V2_CANDIDATE"},
    "approval_id": {"type": "string", "minLength": 1},
    "gate_receipt_id": {"type": "string", "minLength": 1},
    "gate_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "target_id": {"type": "string", "minLength": 1},
    "target_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "principal_profile_id": {"type": "string", "minLength": 1},
    "principal_profile_sha256": {"$ref": "#/$defs/sha256"},
    "authority_epoch": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["APPROVE", "REJECT", "HOLD"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["key_id","algorithm","signature"], "properties": {"key_id":{"type":"string","minLength":1},"algorithm":{"const":"Ed25519"},"signature":{"type":"string","minLength":32}}},
    "approval_sha256": {"$ref": "#/$defs/sha256"},
    "final_lock_authorized": {"type": "boolean"}
  },
  "allOf": [
    {"if":{"properties":{"decision":{"const":"APPROVE"}}},"then":{"properties":{"final_lock_authorized":{"const":true}}}},
    {"if":{"properties":{"decision":{"enum":["REJECT","HOLD"]}}},"then":{"properties":{"final_lock_authorized":{"const":false}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
