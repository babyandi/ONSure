{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/requirement-universe-generation-receipt.v1.schema.json",
  "title": "ONSure Requirement Universe Generation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "generation_algorithm_version", "authority_document_count",
    "explicit_id_requirement_count", "candidate_extracted_requirement_count",
    "duplicate_candidate_group_count", "requirement_manifest_digest", "started_at",
    "completed_at", "decision", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_REQUIREMENT_UNIVERSE_GENERATION_RECEIPT_V1"},
    "generation_algorithm_version": {"type": "string", "minLength": 1},
    "authority_document_count": {"type": "integer", "minimum": 0},
    "explicit_id_requirement_count": {"type": "integer", "minimum": 0},
    "candidate_extracted_requirement_count": {"type": "integer", "minimum": 0},
    "duplicate_candidate_group_count": {"type": "integer", "minimum": 0},
    "requirement_manifest_digest": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["GENERATED_NONFINAL", "FAILED"]},
    "failure_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "FAILED"}}},
      "then": {"required": ["failure_reasons"], "properties": {"failure_reasons": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
