{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/local-agent-receipt.v1.schema.json",
  "title": "ONSURE Local Agent Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "authority",
    "run_id",
    "assurance_run_id",
    "run_started_at",
    "input_digest",
    "decision",
    "created_at",
    "execution_mode",
    "role_policy",
    "evidence_scope",
    "key_id",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "contract": {"const": "ONSURE_LOCAL_AGENT_RECEIPT_V1"},
    "authority": {"type": "string", "enum": ["OTESTER", "OAUDIT"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "assurance_run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"const": "PASS"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"const": "LOCAL_SEPARATE_JVM"},
    "role_policy": {"type": "string", "minLength": 1},
    "evidence_scope": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "Ed25519"},
    "signature": {"type": "string", "minLength": 32}
  }
}
