{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/assurance-receipt-envelope.candidate.v2.schema.json",
  "title": "ONSure Assurance Receipt Envelope Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "receipt_id", "receipt_type", "subject", "context", "authority",
    "independence", "qualification", "freshness", "decision", "reason_codes",
    "parent_receipts", "evidence_refs", "canonicalization", "created_at", "signature",
    "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ASSURANCE_RECEIPT_ENVELOPE_V2_CANDIDATE"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "receipt_type": {"type": "string", "pattern": "^[A-Z0-9_:-]{3,160}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "target_digest", "subject_type", "subject_id", "subject_digest"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "target_digest": {"$ref": "#/$defs/sha256"},
        "subject_type": {"type": "string", "pattern": "^[A-Z0-9_:-]{3,128}$"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "workspace_id", "scope_epoch", "requirement_epoch", "policy_epoch", "environment_digest", "toolchain_digest"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "workspace_id": {"type": "string", "minLength": 1},
        "scope_epoch": {"type": "string", "minLength": 1},
        "requirement_epoch": {"type": "string", "minLength": 1},
        "denominator_epoch": {"type": ["string", "null"]},
        "policy_epoch": {"type": "string", "minLength": 1},
        "environment_digest": {"$ref": "#/$defs/sha256"},
        "toolchain_digest": {"$ref": "#/$defs/sha256"},
        "oracle_set_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})$"},
        "validator_set_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})$"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_id", "authority_profile_id", "authority_profile_sha256", "registry_epoch", "purpose", "valid_at_effect"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "authority_profile_id": {"type": "string", "minLength": 1},
        "authority_profile_sha256": {"$ref": "#/$defs/sha256"},
        "registry_epoch": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "nonce": {"type": ["string", "null"], "minLength": 16},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "valid_at_effect": {"type": "boolean"}
      }
    },
    "independence": {
      "type": "object", "additionalProperties": false,
      "required": ["assurance_class", "independent", "profile_id", "profile_sha256"],
      "properties": {
        "assurance_class": {"enum": ["SELF_VALIDATION_NONFINAL", "PARTIAL_INDEPENDENCE", "INDEPENDENT_VERIFICATION", "INDEPENDENT_AUDIT", "HUMAN_FINAL_AUTHORITY"]},
        "independent": {"type": "boolean"},
        "profile_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "qualification_epoch"],
      "properties": {
        "state": {"enum": ["NOT_QUALIFIED", "PARTIAL", "QUALIFIED_NONFINAL", "QUALIFIED", "STALE", "FAILED"]},
        "qualification_epoch": {"type": "string", "minLength": 1},
        "qualification_receipt_sha256": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})$"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "evaluated_at", "freshness_epoch"],
      "properties": {
        "state": {"enum": ["CURRENT", "STALE", "REVOKED", "INVALIDATED", "STATUS_UNKNOWN", "REASSESSMENT_REQUIRED"]},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "freshness_epoch": {"type": "string", "minLength": 1},
        "freshness_receipt_sha256": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})$"}
      }
    },
    "decision": {"enum": ["PASS", "FAIL", "BLOCKED", "HOLD", "NOT_RUN", "INCONCLUSIVE", "NON_FINAL", "INPUT_REQUIRED"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_:-]{3,160}$"}},
    "parent_receipts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/receiptRef"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "canonicalization": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "profile_version", "payload_sha256"],
      "properties": {
        "profile": {"const": "ONSURE_CANONICAL_JSON"},
        "profile_version": {"const": "2.0"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 32}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PASS"}}},
      "then": {"properties": {"freshness": {"properties": {"state": {"const": "CURRENT"}}}}}
    },
    {
      "if": {"properties": {"independence": {"properties": {"assurance_class": {"enum": ["INDEPENDENT_VERIFICATION", "INDEPENDENT_AUDIT"]}}}}},
      "then": {"properties": {"independence": {"properties": {"independent": {"const": true}}}, "qualification": {"properties": {"state": {"enum": ["QUALIFIED_NONFINAL", "QUALIFIED"]}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receiptRef": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "receipt_type", "receipt_sha256"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_type": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256", "role"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["PRIMARY", "CORROBORATING", "LIMITATION", "REVOCATION", "QUALIFICATION", "FRESHNESS"]}
      }
    }
  }
}
