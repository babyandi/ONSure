{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/execution-plan-approval-evidence.v1.schema.json",
  "title": "ONSure Execution Plan Approval Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "plan_id", "target_id", "source_tree_sha256", "plan_file_sha256",
    "plan_sha256", "approval_state", "approved_actions", "authority_class",
    "approval_id", "approval_actor", "approval_key_id", "signed_receipt_sha256",
    "created_at", "final_claim_allowed", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_EXECUTION_PLAN_APPROVAL_EVIDENCE_V1"},
    "plan_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "approval_state": {"enum": ["AUTO_APPROVED_DEVELOPMENT_NONFINAL", "USER_APPROVED"]},
    "approved_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "authority_class": {"enum": ["INTERNAL_POLICY_AUTO_NONFINAL", "HUMAN_OR_EXTERNAL_APPROVER"]},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_actor": {"type": "string", "minLength": 1},
    "approval_key_id": {"type": "string", "minLength": 1},
    "signed_receipt_sha256": {"pattern": "^(?:[0-9a-f]{64}|NOT_APPLICABLE)$"},
    "created_at": {"type": "string", "format": "date-time"},
    "final_claim_allowed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
