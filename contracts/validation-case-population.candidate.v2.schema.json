{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/validation-case-population.candidate.v2.schema.json",
  "title": "ONSure Validation Case Population Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "population_id", "target_id", "denominator_epoch", "source_registry_sha256",
    "cases", "population_digest", "created_at", "decision", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_VALIDATION_CASE_POPULATION_V2_CANDIDATE"},
    "population_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "denominator_epoch": {"type": "string", "minLength": 1},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "case_sha256", "case_class", "requirement_ids", "applicability",
          "oracle_id", "oracle_sha256", "fixture_id", "fixture_sha256", "test_identity",
          "expected_disposition"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_sha256": {"$ref": "#/$defs/sha256"},
          "case_class": {"enum": ["POSITIVE", "NEGATIVE", "ADVERSARIAL", "MUTATION", "RECOVERY", "FRESHNESS", "AUTHORITY"]},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE_JUSTIFIED"]},
          "applicability_receipt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
          "oracle_id": {"type": "string", "minLength": 1},
          "oracle_sha256": {"$ref": "#/$defs/sha256"},
          "fixture_id": {"type": "string", "minLength": 1},
          "fixture_sha256": {"$ref": "#/$defs/sha256"},
          "test_identity": {
            "type": "object", "additionalProperties": false,
            "required": ["test_class", "test_method", "test_code_sha256"],
            "properties": {
              "test_class": {"type": "string", "minLength": 1},
              "test_method": {"type": "string", "minLength": 1},
              "test_code_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "expected_disposition": {"enum": ["PASS", "FAIL", "BLOCKED", "HOLD", "INCONCLUSIVE"]}
        }
      }
    },
    "population_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["NON_FINAL", "HOLD", "BLOCKED"]},
    "final_claim_allowed": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
