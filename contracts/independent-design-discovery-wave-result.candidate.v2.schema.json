{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/independent-design-discovery-wave-result/v2",
  "title":"ONSure Independent Design Discovery Wave Result V2",
  "type":"object",
  "required":["contract","wave_id","frozen_tree_sha","frozen_authority_digest","mandatory_lens_coverage_percent","untriaged_candidate_count","new_p0_count","blocking_p1_count","nonblocking_p1_count","authority_affecting_p1_count","triage_percent","reviewer_principal","reviewer_process_lineage","model_or_method_lineage","same_authoring_context_attestation","prior_conclusion_exposure_attestation","common_control_dimensions","common_control_attestation","candidate_ledger_digest","receipt_digest","final_claim_allowed"],
  "properties":{
    "contract":{"const":"ONSURE_INDEPENDENT_DESIGN_DISCOVERY_WAVE_RESULT_V2"},
    "wave_id":{"enum":["INDEPENDENT-SATURATION-A","INDEPENDENT-SATURATION-B"]},
    "frozen_tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "frozen_authority_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mandatory_lens_coverage_percent":{"type":"integer","minimum":0,"maximum":100},
    "untriaged_candidate_count":{"type":"integer","minimum":0},
    "new_p0_count":{"type":"integer","minimum":0},
    "blocking_p1_count":{"type":"integer","minimum":0},
    "nonblocking_p1_count":{"type":"integer","minimum":0},
    "authority_affecting_p1_count":{"type":"integer","minimum":0},
    "authority_affecting_p1_disposition_count":{"type":"integer","minimum":0},
    "triage_percent":{"type":"integer","minimum":0,"maximum":100},
    "reviewer_principal":{"type":"string","minLength":1},
    "reviewer_process_lineage":{"type":"string","minLength":1},
    "model_or_method_lineage":{"type":"string","minLength":1},
    "same_authoring_context_attestation":{"type":"boolean"},
    "prior_conclusion_exposure_attestation":{"type":"boolean"},
    "common_control_dimensions":{"type":"array","items":{"type":"object","required":["id","present","mitigation_evidence"],"properties":{"id":{"type":"string","minLength":1},"present":{"type":"boolean"},"mitigation_evidence":{"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":true}},
    "common_control_attestation":{"type":"string","minLength":1},
    "candidate_ledger_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "final_claim_allowed":{"const":false}
  },
  "additionalProperties":true
}
