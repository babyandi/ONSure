{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/inferred-e2e-execution-authorization.v1.schema.json",
  "title": "ONSure Inferred E2E Execution Authorization V1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "execution_authorization_id", "project_id", "target_id", "source_sha256", "profile_file_sha256", "review_sha256", "approval_request_id", "approval_request_sha256", "approval_receipt_sha256", "continuation_approval_manifest_sha256", "authorization_expires_at", "runtime_reference_ids", "execution_scope", "candidate_count", "blocked_candidate_count", "authorized_candidates", "authorized_lifecycles", "authorized_continuations", "blocked_continuations", "continuation_authorization_policy", "binding_authorization_policy", "plan_state", "execution_state", "source_mutation_allowed", "customer_data_allowed", "destructive_action_allowed", "final_claim_allowed"],
  "properties": {
    "contract": {"const": "ONSURE_INFERRED_E2E_EXECUTION_AUTHORIZATION_V1"},
    "execution_authorization_id": {"type": "string", "pattern": "^inferred-e2e-auth-[0-9a-f-]{36}$"},
    "project_id": {"type": "string"}, "target_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_request_id": {"type": "string", "pattern": "^program-understanding-approval-[0-9a-f-]{36}$"},
    "approval_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "continuation_approval_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_expires_at": {"type": "string", "format": "date-time"},
    "runtime_reference_ids": {"type": "object", "additionalProperties": false, "properties": {
      "authentication": {"type": "string", "pattern": "^env:[A-Z][A-Z0-9_]{1,127}$"},
      "test_identity": {"type": "string", "pattern": "^env:[A-Z][A-Z0-9_]{1,127}$"}
    }},
    "execution_scope": {"const": "ISOLATED_SYNTHETIC_LOOPBACK"},
    "candidate_count": {"type": "integer", "minimum": 0}, "blocked_candidate_count": {"type": "integer", "minimum": 0},
    "authorized_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "authorized_lifecycles": {"type": "array", "items": {"$ref": "#/$defs/lifecycle"}},
    "authorized_continuations": {"type": "array", "items": {"$ref": "#/$defs/continuation"}},
    "blocked_continuations": {"type": "array", "items": {"$ref": "#/$defs/continuation"}},
    "continuation_authorization_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_kind", "allowed_methods", "same_operation_only", "same_service_only", "cross_service_auto_binding_allowed", "redirect_policy", "maximum_cumulative_response_bytes", "raw_continuation_token_storage_allowed", "async_poll_state", "multi_service_state"],
      "properties": {
        "allowed_kind": {"const": "PAGINATION"}, "allowed_methods": {"const": ["GET", "HEAD"]},
        "same_operation_only": {"const": true}, "same_service_only": {"const": true},
        "cross_service_auto_binding_allowed": {"const": false}, "redirect_policy": {"const": "NEVER"},
        "maximum_cumulative_response_bytes": {"const": 8388608},
        "raw_continuation_token_storage_allowed": {"const": false},
        "async_poll_state": {"const": "BLOCKED_NOT_RUN"}, "multi_service_state": {"const": "BLOCKED_NOT_RUN"}
      }
    },
    "binding_authorization_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_confidence", "allowed_inference_basis", "executable_consumer_locations", "candidate_only_consumer_locations", "separate_review_required", "separate_approval_required", "unqualified_binding_outcome", "raw_value_storage_allowed"],
      "properties": {
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "allowed_inference_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "executable_consumer_locations": {"const": ["PATH", "QUERY", "HEADER", "BODY"]},
        "candidate_only_consumer_locations": {"const": []},
        "separate_review_required": {"const": true},
        "separate_approval_required": {"const": true},
        "unqualified_binding_outcome": {"const": "BLOCKED_NOT_RUN"},
        "raw_value_storage_allowed": {"const": false}
      }
    },
    "plan_state": {"enum": ["AUTHORIZED_NOT_RUN", "PARTIAL_AUTHORIZATION_BLOCKED_NOT_RUN"]},
    "execution_state": {"const": "NOT_RUN"}, "source_mutation_allowed": {"const": false},
    "customer_data_allowed": {"const": false}, "destructive_action_allowed": {"const": false},
    "final_claim_allowed": {"const": false}
  },
  "$defs": {
    "continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["continuation_id", "kind", "plan_id", "openapi_document_id", "service_boundary_id", "producer_location", "producer_reference", "consumer_location", "consumer_reference", "max_iterations", "max_duration_seconds", "max_cumulative_response_bytes", "termination_policy", "review_sha256", "approval_receipt_sha256", "approval_manifest_sha256", "raw_continuation_token_storage_allowed", "review_state", "state"],
      "properties": {
        "continuation_id": {"type": "string", "pattern": "^CONT-[0-9a-f]{16}$"},
        "kind": {"enum": ["PAGINATION", "ASYNC_POLL"]}, "plan_id": {"type": "string"},
        "openapi_document_id": {"type": "string"}, "service_boundary_id": {"type": "string"},
        "producer_location": {"enum": ["BODY_POINTER", "RESPONSE_HEADER", "UNRESOLVED"]},
        "producer_reference": {"type": "string"}, "consumer_location": {"enum": ["QUERY", "UNRESOLVED"]},
        "consumer_reference": {"type": "string"}, "max_iterations": {"type": "integer", "minimum": -1, "maximum": 100},
        "max_duration_seconds": {"type": "integer", "minimum": -1, "maximum": 300},
        "max_cumulative_response_bytes": {"const": 8388608},
        "termination_policy": {"type": "string"}, "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_continuation_token_storage_allowed": {"const": false},
        "review_state": {"enum": ["REVIEWED_AND_SEPARATELY_APPROVED", "REVIEW_REQUIRED_NOT_AUTHORIZED"]},
        "state": {"enum": ["AUTHORIZED_NOT_RUN", "BLOCKED_NOT_RUN"]},
        "blocked_reason": {"const": "ASYNC_OR_UNSAFE_OR_CROSS_SERVICE_CONTINUATION_NOT_EXECUTABLE"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "producer_plan_id", "producer_json_pointer", "consumer_plan_id", "consumer_location", "consumer_parameter_name", "producer_schema_type", "consumer_schema_type", "inference_basis", "inference_confidence", "review_sha256", "approval_receipt_sha256", "auto_execute_before_approval", "review_state", "value_storage_allowed", "state"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^BINDING-[0-9a-f]{16}$"},
        "producer_plan_id": {"type": "string"}, "producer_json_pointer": {"type": "string", "pattern": "^/.+$"},
        "consumer_plan_id": {"type": "string"}, "consumer_location": {"enum": ["PATH", "QUERY", "HEADER", "BODY"]},
        "consumer_parameter_name": {"type": "string"}, "value_storage_allowed": {"const": false},
        "producer_schema_type": {"enum": ["STRING", "INTEGER", "NUMBER", "BOOLEAN", "UNKNOWN"]},
        "consumer_schema_type": {"enum": ["STRING", "INTEGER", "NUMBER", "BOOLEAN", "UNKNOWN", "HTTP_SERIALIZED"]},
        "inference_basis": {"type": "string", "minLength": 1},
        "inference_confidence": {"type": "number", "minimum": -1, "maximum": 1},
        "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "auto_execute_before_approval": {"const": false},
        "review_state": {"enum": ["REVIEWED_AND_SEPARATELY_APPROVED", "REVIEW_REQUIRED_NOT_AUTHORIZED"]},
        "blocked_reason": {"enum": ["INFERENCE_CONFIDENCE_OR_BASIS_NOT_AUTOMATICALLY_AUTHORIZABLE", "CONSUMER_LOCATION_RUNNER_NOT_IMPLEMENTED", "BODY_SCHEMA_TYPE_INCOMPATIBLE_OR_UNVERIFIED"]},
        "state": {"enum": ["AUTHORIZED_NOT_RUN", "BLOCKED_BINDING_REVIEW_REQUIRED"]}
      },
      "allOf": [{
        "if": {"properties": {"state": {"const": "AUTHORIZED_NOT_RUN"}}},
        "then": {"properties": {"consumer_location": {"enum": ["PATH", "QUERY", "HEADER", "BODY"]}, "review_state": {"const": "REVIEWED_AND_SEPARATELY_APPROVED"}}, "not": {"required": ["blocked_reason"]}},
        "else": {"required": ["blocked_reason"], "properties": {"review_state": {"const": "REVIEW_REQUIRED_NOT_AUTHORIZED"}}}
      }]
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycle_id", "business_object", "operation_plan_ids", "bindings", "binding_count", "blocked_bindings", "blocked_binding_count", "execution_state", "response_values_storage_allowed", "final_claim_allowed"],
      "properties": {
        "lifecycle_id": {"type": "string", "pattern": "^LIFECYCLE-[0-9a-f]{16}$"},
        "business_object": {"type": "string"},
        "operation_plan_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "binding_count": {"type": "integer", "minimum": 0},
        "blocked_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "blocked_binding_count": {"type": "integer", "minimum": 0},
        "execution_state": {"enum": ["AUTHORIZED_NOT_RUN", "PARTIAL_AUTHORIZATION_BLOCKED_NOT_RUN"]},
        "response_values_storage_allowed": {"const": false}, "final_claim_allowed": {"const": false}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "flow_id", "http_method", "http_path", "request_schema_refs", "request_schema_declared", "security_declared", "response_statuses", "openapi_document_id", "service_boundary_id", "openapi_source_path", "openapi_source_sha256", "fixture_strategy", "oracle_strategy", "state", "customer_data_allowed", "destructive_action_allowed"],
      "properties": {
        "plan_id": {"type": "string"}, "flow_id": {"type": "string"},
        "http_method": {"enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE", "NONE"]},
        "http_path": {"type": "string", "maxLength": 4096},
        "request_schema_refs": {"type": "array", "items": {"type": "string"}},
        "request_schema_declared": {"type": "boolean"},
        "security_declared": {"type": "boolean"},
        "response_statuses": {"type": "array", "items": {"type": "string"}},
        "openapi_document_id": {"type": "string"}, "service_boundary_id": {"type": "string"},
        "openapi_source_path": {"type": "string"},
        "openapi_source_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"const": "NOT_APPLICABLE"}]},
        "fixture_strategy": {"type": "string"}, "oracle_strategy": {"type": "string"},
        "state": {"type": "string", "pattern": "^(READY_FOR_|BLOCKED_).+$"},
        "binding_execution_state": {"const": "NOT_RUN"},
        "customer_data_allowed": {"const": false}, "destructive_action_allowed": {"const": false}
      }
    }
  }
}
