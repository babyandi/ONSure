{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onsure://contracts/dd-assurance-request/v1",
  "title": "ONSure DD Assurance Request",
  "type": "object",
  "required": ["dd_id", "evidence_refs"],
  "properties": {
    "dd_id": {"type":"string","pattern":"^DD-(00[1-9]|0[1-3][0-9]|040)$"},
    "project_id": {"type":"string","minLength":1},
    "target_id": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "policy_ref": {"type":"string"},
    "authority_ref": {"type":"string"},
    "context": {"type":"object"}
  },
  "allOf": [
    {"not":{"required":["final_claim_allowed"]}},
    {"not":{"required":["decision_override"]}},
    {"not":{"required":["_authorized_target_root"]}}
  ],
  "additionalProperties": true
}
