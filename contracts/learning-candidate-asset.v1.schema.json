{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/learning-candidate-asset.v1.schema.json",
  "title": "ONSure Learning Candidate Asset v1",
  "description": "149_LEARNING_VALIDATION_SCHEMA_FIXTURE_SPECIFICATION.md SS A. final_decision_authority is always false -- a LearningCandidateAsset never issues a Final Decision by itself (148 P0 invariant 1); ACTIVE requires qualification evidence to have already been recorded via a LearningPromotionReceipt (148 P0 invariant 3), enforced by the cross-contract validator, not by this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "candidate_id", "candidate_type", "state", "learning_domain", "scope",
    "source_lineage", "content_sha256", "created_by", "created_at", "final_decision_authority"
  ],
  "properties": {
    "contract": {"const": "ONSURE_LEARNING_CANDIDATE_ASSET_V1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_type": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "OBSERVED", "CANDIDATE", "EVALUATED", "QUALIFIED", "APPROVED", "ACTIVE",
        "RETIRED", "REJECTED", "QUARANTINED", "STALE", "REVOKED", "SUPERSEDED"
      ]
    },
    "learning_domain": {"type": "string", "minLength": 1},
    "scope": {"enum": ["TENANT", "ORGANIZATION", "INDUSTRY", "GLOBAL"]},
    "source_lineage": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "final_decision_authority": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "ACTIVE"}}},
      "then": {"properties": {"source_lineage": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
