{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/learning-history-migration-check.v1.schema.json",
  "title": "ONSure Learning History Migration Check v1",
  "description": "FR-LEARN-072 Learning History Migration: Schema/registry/knowledge-store migration 시 candidate lifecycle, lineage, old decisions, revoked assets, qualification evidence를 보존한다. migration 후 history loss가 있으면 reconstructability PASS 금지. Any category whose post-migration record count is lower than its pre-migration count is the named negative case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "migration_id", "subject_id", "categories", "decision",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_LEARNING_HISTORY_MIGRATION_CHECK_V1"},
    "migration_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "categories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "pre_migration_count", "post_migration_count"],
        "properties": {
          "category": {
            "enum": [
              "CANDIDATE_LIFECYCLE", "LINEAGE", "OLD_DECISIONS",
              "REVOKED_ASSETS", "QUALIFICATION_EVIDENCE"
            ]
          },
          "pre_migration_count": {"type": "integer", "minimum": 0},
          "post_migration_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "decision": {"enum": ["RECONSTRUCTABILITY_PRESERVED", "RECONSTRUCTABILITY_BLOCKED"]},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  }
}
