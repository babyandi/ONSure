{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/security-baseline-check.v1.schema.json",
  "title": "ONSure Security Baseline Check v1",
  "description": "NFR-SEC: '저장·전송 암호화, Secret 비노출, 최소권한.' Four independent real computations, one per named sub-requirement: storage_encryption_compliant is a real ordinal comparison against the declared algorithm strength (AES-256 or stronger required, per 08_REVIEW_CHECKLIST_OPEN_DECISIONS.md C8). tls_compliant is a real ordinal comparison (TLS 1.2 or higher required; below is rejected). secret_exposure_clear is a real count check (secret_pattern_matches_found must be exactly 0). least_privilege_compliant is a real set-difference between a role's actually-callable operations and its documented allow-list -- any operation callable beyond the documented list is excess privilege, not a caller-declared summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "storage_encryption_algorithm", "tls_version",
    "secret_pattern_matches_found", "role_id", "role_actual_callable_operations",
    "role_documented_allowed_operations", "storage_encryption_compliant", "tls_compliant",
    "secret_exposure_clear", "excess_operations", "least_privilege_compliant", "compliant",
    "reasons", "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_SECURITY_BASELINE_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "storage_encryption_algorithm": {"enum": ["NONE", "AES_128", "AES_256", "AES_256_GCM"]},
    "tls_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "secret_pattern_matches_found": {"type": "integer", "minimum": 0},
    "role_id": {"enum": ["VIEWER", "OPERATOR", "APPROVER", "AUDITOR", "ADMIN"]},
    "role_actual_callable_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "role_documented_allowed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "storage_encryption_compliant": {"type": "boolean"},
    "tls_compliant": {"type": "boolean"},
    "secret_exposure_clear": {"type": "boolean"},
    "excess_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "least_privilege_compliant": {"type": "boolean"},
    "compliant": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"compliant": {"const": true}}},
      "then": {
        "properties": {
          "storage_encryption_compliant": {"const": true},
          "tls_compliant": {"const": true},
          "secret_exposure_clear": {"const": true},
          "least_privilege_compliant": {"const": true},
          "excess_operations": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"excess_operations": {"minItems": 1}}},
      "then": {"properties": {"least_privilege_compliant": {"const": false}, "compliant": {"const": false}}}
    },
    {
      "if": {"properties": {"secret_pattern_matches_found": {"minimum": 1}}},
      "then": {"properties": {"secret_exposure_clear": {"const": false}, "compliant": {"const": false}}}
    }
  ]
}
