{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.dev/contracts/semantic-applicability-set.candidate.v2.schema.json",
  "title":"ONSure Semantic Applicability Set Candidate v2",
  "type":"object","additionalProperties":false,
  "required":["contract","applicability_set_id","target_id","target_type","target_digest","capabilities","applicable_count","not_applicable_count","input_required_count","set_digest","evaluated_at"],
  "properties":{
    "contract":{"const":"ONSURE_SEMANTIC_APPLICABILITY_SET_V2_CANDIDATE"},
    "applicability_set_id":{"type":"string","minLength":1},"target_id":{"type":"string","minLength":1},"target_type":{"type":"string","minLength":1},"target_digest":{"$ref":"#/$defs/sha256"},
    "capabilities":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"object","additionalProperties":false,"required":["capability_id","disposition","rule_id","rule_digest","reason_codes"],"properties":{"capability_id":{"pattern":"^SA-(?:0[1-9]|1[0-4])$"},"disposition":{"enum":["APPLICABLE","NOT_APPLICABLE_JUSTIFIED","INPUT_REQUIRED","HOLD"]},"rule_id":{"type":"string","minLength":1},"rule_digest":{"$ref":"#/$defs/sha256"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"challenge_receipt_sha256":{"type":["string","null"],"pattern":"^(?:[0-9a-f]{64})$"}}}},
    "applicable_count":{"type":"integer","minimum":0},"not_applicable_count":{"type":"integer","minimum":0},"input_required_count":{"type":"integer","minimum":0},
    "set_digest":{"$ref":"#/$defs/sha256"},"evaluated_at":{"type":"string","format":"date-time"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
