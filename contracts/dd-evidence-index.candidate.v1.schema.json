{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/dd-evidence-index/v2",
  "title":"ONSure DD Runtime Evidence Index",
  "type":"object",
  "required":["contract","source_commit_sha","source_tree_sha","path_base","rows","final_claim_allowed"],
  "properties":{
    "contract":{"const":"ONSURE_DD_EVIDENCE_INDEX_V2"},
    "source_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "path_base":{"enum":["WORKSPACE_ROOT","INDEX_DIRECTORY"]},
    "rows":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["evidence_ref","dd_ids","path","sha256","current","authority_ref"],
        "properties":{
          "evidence_ref":{"type":"string","minLength":1},
          "dd_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^DD-(00[1-9]|0[1-3][0-9]|040)$"}},
          "path":{"type":"string","minLength":1},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "current":{"type":"boolean"},
          "authority_ref":{"type":"string","minLength":1}
        },
        "additionalProperties":true
      }
    },
    "final_claim_allowed":{"const":false}
  },
  "additionalProperties":true
}
