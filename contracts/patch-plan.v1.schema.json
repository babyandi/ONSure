{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/patch-plan.v1.schema.json",
  "title": "ONSure Patch Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "patch_plan_id", "diagnosis_id", "source_ref", "patch_sha256",
    "changed_files", "hunks", "risk", "rollback_ref", "approval", "state", "created_at"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PATCH_PLAN_V1"},
    "patch_plan_id": {"type": "string", "minLength": 1},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_files": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "hunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hunk_id", "file", "header", "digest", "approved"],
        "properties": {
          "hunk_id": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "header": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "approved": {"type": "boolean"}
        }
      }
    },
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "rollback_ref": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approved_hunk_ids", "approved_by", "approved_at", "approval_receipt_sha256"],
      "properties": {
        "state": {"enum": ["AWAITING_APPROVAL", "PARTIALLY_APPROVED", "APPROVED", "REJECTED"]},
        "approved_hunk_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "approval_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "state": {"enum": ["AWAITING_PATCH_APPROVAL", "PATCH_APPROVED", "HOLD"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
