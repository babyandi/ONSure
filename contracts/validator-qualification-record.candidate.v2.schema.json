{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.dev/contracts/validator-qualification-record.candidate.v2.schema.json",
  "title":"ONSure Validator Qualification Record Candidate v2",
  "type":"object","additionalProperties":false,
  "required":["contract","qualification_id","validator","capabilities","method_manifest_sha256","benchmark_manifest_sha256","isolation","critical_denominator","critical_found","critical_miss_count","strict_recall","mutation","validity","decision","evidence_refs","qualification_sha256"],
  "properties":{
    "contract":{"const":"ONSURE_VALIDATOR_QUALIFICATION_RECORD_V2_CANDIDATE"},"qualification_id":{"type":"string","minLength":1},
    "validator":{"type":"object","additionalProperties":false,"required":["validator_id","version","implementation_sha256"],"properties":{"validator_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"implementation_sha256":{"$ref":"#/$defs/sha256"}}},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"pattern":"^SA-(?:0[1-9]|1[0-4])$"}},
    "method_manifest_sha256":{"$ref":"#/$defs/sha256"},"benchmark_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "isolation":{"type":"object","additionalProperties":false,"required":["state","principal_profile_sha256","blind_context_sha256"],"properties":{"state":{"enum":["PROVEN","PARTIAL","NOT_PROVEN","COMPROMISED"]},"principal_profile_sha256":{"$ref":"#/$defs/sha256"},"blind_context_sha256":{"type":["string","null"],"pattern":"^(?:[0-9a-f]{64})$"}}},
    "critical_denominator":{"type":"integer","minimum":0},"critical_found":{"type":"integer","minimum":0},"critical_miss_count":{"type":"integer","minimum":0},"strict_recall":{"type":"number","minimum":0,"maximum":1},
    "mutation":{"type":"object","additionalProperties":false,"required":["families","seeded_count","escaped_count"],"properties":{"families":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CODE","CONTRACT","AUTHORITY","DENOMINATOR","EVIDENCE","DESIGN_OMISSION","CROSS_ARTIFACT_MAPPING","OBSERVER_COLLECTOR"]}},"seeded_count":{"type":"integer","minimum":1},"escaped_count":{"type":"integer","minimum":0}}},
    "validity":{"type":"object","additionalProperties":false,"required":["qualification_epoch","valid_from","valid_until","stale_triggers"],"properties":{"qualification_epoch":{"type":"string","minLength":1},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"stale_triggers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "decision":{"enum":["QUALIFIED","QUALIFIED_NONFINAL","PARTIAL","FAILED","HOLD"]},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}},"qualification_sha256":{"$ref":"#/$defs/sha256"}
  },
  "allOf":[{"if":{"properties":{"decision":{"const":"QUALIFIED"}}},"then":{"properties":{"critical_miss_count":{"const":0},"strict_recall":{"const":1},"isolation":{"properties":{"state":{"const":"PROVEN"}}},"mutation":{"properties":{"escaped_count":{"const":0}}}}}}],
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
