{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/program-profile.v1.schema.json",
  "title": "ONSure Program Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "profile_id", "project_id", "program_id", "source_baseline",
    "purpose", "components", "dependencies", "ai_components", "data_flows",
    "unknowns", "conflicts", "evidence_refs", "revision", "state", "generated_at",
    "learning_method", "language_inventory", "dynamic_trace", "runtime_verification",
    "human_review", "independent_validation", "final_claim_allowed", "profile_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PROGRAM_PROFILE_V1"},
    "profile_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "source_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type", "reference_value", "git_commit_sha", "source_tree_sha256",
        "worktree_clean", "snapshot_complete", "source_file_count"
      ],
      "properties": {
        "reference_type": {"enum": ["GIT_COMMIT", "SOURCE_TREE_SHA256"]},
        "reference_value": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "git_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "worktree_clean": {"type": ["boolean", "null"]},
        "snapshot_complete": {"const": true},
        "source_file_count": {"type": "integer", "minimum": 1}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "components": {"type": "array", "items": {"$ref": "#/$defs/evidenceBoundItem"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/evidenceBoundItem"}},
    "ai_components": {"type": "array", "items": {"$ref": "#/$defs/evidenceBoundItem"}},
    "data_flows": {"type": "array", "items": {"$ref": "#/$defs/evidenceBoundItem"}},
    "workflow_inventory": {"$ref": "#/$defs/workflowInventory"},
    "program_understanding": {
      "type": "object",
      "required": ["contract", "source_sha256", "flow_candidates", "e2e_plan_candidates", "minimal_questions", "inferences_are_pass_evidence", "final_claim_allowed"],
      "properties": {
        "contract": {"const": "ONSURE_PROGRAM_UNDERSTANDING_CANDIDATE_V1"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "flow_candidates": {"type": "array"},
        "e2e_plan_candidates": {"type": "array"},
        "minimal_questions": {"type": "array"},
        "inferences_are_pass_evidence": {"const": false},
        "final_claim_allowed": {"const": false}
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["PROFILE_CANDIDATE", "PROFILE_REVIEWED", "PROFILE_ACTIVE", "STALE", "HOLD"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "learning_method": {"const": "STATIC_REPOSITORY_UNDERSTANDING_V2"},
    "language_inventory": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "dynamic_trace": {"enum": ["NOT_RUN", "PARTIAL", "PASS", "FAIL", "HOLD"]},
    "runtime_verification": {"enum": ["NOT_RUN", "PARTIAL", "PASS", "FAIL", "HOLD"]},
    "human_review": {"enum": ["NOT_RUN", "PASS", "FAIL", "HOLD"]},
    "independent_validation": {"enum": ["NOT_RUN", "PASS", "FAIL", "HOLD"]},
    "final_claim_allowed": {"const": false},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "workflowInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "source_digest", "source_file_count", "execution_policy", "candidate_count", "candidate_kind_counts",
        "candidates", "parse_findings", "truncated", "runtime_verification",
        "auto_execute", "final_claim_allowed"
      ],
      "properties": {
        "contract": {"const": "ONSURE_STATIC_WORKFLOW_INVENTORY_V1"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_file_count": {"type": "integer", "minimum": 1},
        "execution_policy": {"const": "DISCOVERY_ONLY_REVIEW_REQUIRED"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_kind_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id", "kind", "name", "source_path", "evidence_sha256",
              "invocation_type", "role_hints", "confidence", "runtime_verified",
              "review_required", "auto_execute"
            ],
            "properties": {
              "candidate_id": {"type": "string", "pattern": "^WF-[0-9a-f]{16}$"},
              "kind": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1, "maxLength": 512},
              "source_path": {"type": "string", "minLength": 1},
              "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "invocation_type": {"type": "string", "minLength": 1},
              "role_hints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "runtime_verified": {"const": false},
              "review_required": {"const": true},
              "auto_execute": {"const": false}
            }
          }
        },
        "parse_findings": {"type": "array", "items": {"type": "string"}},
        "truncated": {"type": "boolean"},
        "runtime_verification": {"const": "NOT_RUN"},
        "auto_execute": {"const": false},
        "final_claim_allowed": {"const": false}
      }
    },
    "evidenceBoundItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "source_locations", "confidence", "verified"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_locations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verified": {"type": "boolean"}
      }
    }
  }
}
