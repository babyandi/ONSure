{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://learning-validation-closed-loop.capabilities.candidate.v1.schema.json",
  "type":"object",
  "required":["type","status","authority","learning_domains","candidate_states","candidate_types","knowledge_scopes","corpus_partitions","evidence_absence_states","capabilities","forbidden_shortcuts","mandatory_p0_gates","final_claim_allowed"],
  "properties":{
    "type":{"const":"ONSURE_LEARNING_VALIDATION_CLOSED_LOOP_CAPABILITIES_V1_CANDIDATE"},
    "status":{"const":"DESIGN_ONLY_NONFINAL"},
    "authority":{"type":"string","minLength":1},
    "learning_domains":{"type":"array","uniqueItems":true,"contains":{"const":"TARGET_LEARNING"}},
    "candidate_states":{"type":"array","uniqueItems":true,"allOf":[{"contains":{"const":"OBSERVED"}},{"contains":{"const":"CANDIDATE"}},{"contains":{"const":"EVALUATED"}},{"contains":{"const":"QUALIFIED"}},{"contains":{"const":"APPROVED"}},{"contains":{"const":"ACTIVE"}},{"contains":{"const":"RETIRED"}}]},
    "candidate_types":{"type":"array","uniqueItems":true,"minItems":6},
    "knowledge_scopes":{"type":"array","uniqueItems":true,"allOf":[{"contains":{"const":"PRIVATE"}},{"contains":{"const":"ORGANIZATION"}},{"contains":{"const":"INDUSTRY"}},{"contains":{"const":"GLOBAL"}}]},
    "corpus_partitions":{"type":"array","uniqueItems":true,"minItems":5},
    "evidence_absence_states":{"type":"array","uniqueItems":true,"allOf":[{"contains":{"const":"EVIDENCE_NOT_COLLECTED"}},{"contains":{"const":"EVIDENCE_COLLECTION_FAILED"}},{"contains":{"const":"OBSERVED_ABSENCE"}},{"contains":{"const":"EVIDENCE_UNAVAILABLE"}},{"contains":{"const":"EVIDENCE_STALE"}},{"contains":{"const":"EVIDENCE_PRESENT"}}]},
    "capabilities":{"type":"array","minItems":25,"maxItems":25,"items":{"type":"object","required":["id","name","p0"],"properties":{"id":{"pattern":"^FR-LEARN-(00[1-9]|01[0-9]|02[0-5])$"},"name":{"type":"string","minLength":1},"p0":{"type":"boolean"}},"additionalProperties":false}},
    "forbidden_shortcuts":{"type":"array","minItems":1,"uniqueItems":true},
    "mandatory_p0_gates":{"type":"array","minItems":7,"uniqueItems":true},
    "final_claim_allowed":{"const":false}
  },
  "additionalProperties":false
}
