{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/hazard.v1.schema.json",
  "title": "ONSure Hazard v1",
  "description": "127_SAFETY_HAZARD_AND_CONTESTABILITY_GOVERNANCE.md SS1.2/1.3. disposition RESIDUAL_RISK_ACCEPTANCE_REQUIRED/VALIDATED_CONTROLLED must never be self-declared from IDENTIFIED without passing through ANALYZED/CONTROL_REQUIRED first (SS8 negative fixture 'unvalidated safe state'); a CATASTROPHIC severity_class hazard can never be dispositioned UNACCEPTABLE-bypassing straight to VALIDATED_CONTROLLED without CONTROLLED_PENDING_VALIDATION.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "hazard_id", "target_subject_id", "target_subject_digest", "description",
    "initiating_conditions", "potential_harms", "severity_class", "disposition",
    "created_by", "created_at"
  ],
  "properties": {
    "contract": {"const": "ONSURE_HAZARD_V1"},
    "hazard_id": {"type": "string", "minLength": 1},
    "target_subject_id": {"type": "string", "minLength": 1},
    "target_subject_digest": {"$ref": "#/$defs/sha256"},
    "description": {"type": "string", "minLength": 1},
    "initiating_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hazardous_scenario_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "potential_harms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "severity_class": {"enum": ["NEGLIGIBLE", "MARGINAL", "CRITICAL", "CATASTROPHIC"]},
    "exposure_class": {"type": ["string", "null"]},
    "controllability_class": {"type": ["string", "null"]},
    "industry_risk_model_ref": {"type": ["string", "null"]},
    "disposition": {
      "enum": [
        "IDENTIFIED", "ANALYZED", "CONTROL_REQUIRED", "CONTROLLED_PENDING_VALIDATION",
        "VALIDATED_CONTROLLED", "RESIDUAL_RISK_ACCEPTANCE_REQUIRED", "UNACCEPTABLE", "STALE"
      ]
    },
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "VALIDATED_CONTROLLED"}}},
      "then": {"not": {"properties": {"severity_class": {"const": "CATASTROPHIC"}}}},
      "description": "A CATASTROPHIC hazard reaching VALIDATED_CONTROLLED directly (as opposed to via RESIDUAL_RISK_ACCEPTANCE_REQUIRED with a distinct safety authority) is the schema-level guard; the full state-machine sequencing invariant is enforced by HazardLedger at runtime, not expressible here alone."
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
