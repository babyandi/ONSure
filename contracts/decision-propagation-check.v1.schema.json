{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/decision-propagation-check.v1.schema.json",
  "title": "ONSure Decision Propagation Check v1",
  "description": "FR-META-009 Decision Propagation: '의존 하위 결과의 FAIL/HOLD/BLOCKED/NOT_RUN/INCONCLUSIVE/UNKNOWN은 상위 Claim에 전파한다. Critical dependency가 미검증이면 전체 PASS로 평균화하지 않는다.' propagated_status is computed by a real fixed precedence over the dependency array (never a caller-declared value): any BLOCKED dependency forces BLOCKED; any FAIL forces FAIL; any CRITICAL dependency left NOT_RUN/UNKNOWN/INCONCLUSIVE forces HOLD (the named negative case: critical-but-unverified can never silently average into PASS); any HOLD forces HOLD; any non-critical unresolved dependency forces INCONCLUSIVE; only when every dependency is genuinely PASS does the claim reach PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "subject_id", "claim_id", "dependencies", "propagated_status",
    "critical_unresolved_dependencies", "non_pass_dependencies", "reasons",
    "self_validation_nonfinal", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_DECISION_PROPAGATION_CHECK_V1"},
    "subject_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "status", "critical"],
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "NOT_RUN", "INCONCLUSIVE", "UNKNOWN"]},
          "critical": {"type": "boolean"}
        }
      }
    },
    "propagated_status": {"enum": ["PASS", "FAIL", "HOLD", "BLOCKED", "INCONCLUSIVE"]},
    "critical_unresolved_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "non_pass_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "self_validation_nonfinal": {"const": true},
    "final_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"propagated_status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "non_pass_dependencies": {"maxItems": 0},
          "critical_unresolved_dependencies": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"dependencies": {"contains": {"properties": {"status": {"const": "BLOCKED"}}}}}},
      "then": {"properties": {"propagated_status": {"const": "BLOCKED"}}}
    },
    {
      "if": {"properties": {"critical_unresolved_dependencies": {"minItems": 1}}},
      "then": {"properties": {"propagated_status": {"not": {"const": "PASS"}}}}
    }
  ]
}
