{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/patch-rollback-receipt.v1.schema.json",
  "title": "ONSure Patch Rollback Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "patch_apply_receipt_sha256", "worktree", "restored_hunks",
    "git_status", "state", "created_at", "final_claim_allowed", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PATCH_ROLLBACK_RECEIPT_V1"},
    "patch_apply_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "worktree": {"type": "string", "minLength": 1},
    "restored_hunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hunk_id", "relative_path", "restored_sha256"],
        "properties": {
          "hunk_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "restored_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "git_status": {"type": "array", "items": {"type": "string"}},
    "state": {"const": "ROLLED_BACK_NONFINAL"},
    "created_at": {"type": "string", "format": "date-time"},
    "final_claim_allowed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}