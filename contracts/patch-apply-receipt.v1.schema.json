{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/patch-apply-receipt.v1.schema.json",
  "title": "ONSure Patch Apply Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "patch_plan_id", "patch_plan_file_sha256", "approval_receipt_sha256",
    "approval_actor", "approval_key_id", "source_commit", "branch", "worktree",
    "applied_hunks", "git_status", "rollback_pointer", "state", "commit_allowed",
    "push_allowed", "merge_allowed", "created_at", "final_claim_allowed", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_PATCH_APPLY_RECEIPT_V1"},
    "patch_plan_id": {"type": "string", "minLength": 1},
    "patch_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "approval_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "approval_actor": {"type": "string", "minLength": 1},
    "approval_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "branch": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "applied_hunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hunk_id", "relative_path", "preimage_sha256", "postimage_sha256", "backup_sha256"],
        "properties": {
          "hunk_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "preimage_sha256": {"$ref": "#/$defs/sha256"},
          "postimage_sha256": {"$ref": "#/$defs/sha256"},
          "backup_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "git_status": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback_pointer": {"type": "string", "minLength": 1},
    "state": {"const": "APPLIED_NONFINAL"},
    "commit_allowed": {"const": false},
    "push_allowed": {"const": false},
    "merge_allowed": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "final_claim_allowed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
