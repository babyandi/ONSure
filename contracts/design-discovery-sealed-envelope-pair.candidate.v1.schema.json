{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"onsure://contracts/design-discovery-sealed-envelope-pair/v1",
  "title":"ONSure Paired Sealed Design Discovery Input Envelopes",
  "type":"object",
  "required":["contract","frozen_tree_sha","frozen_authority_digest","frozen_baseline_receipt_sha256","input_bundle_digest","blind_execution_policy_sha256","prepared_at","prepared_by","prepared_before_any_result","results_present_at_prepare","envelopes","pair_digest","final_claim_allowed"],
  "properties":{
    "contract":{"const":"ONSURE_DESIGN_DISCOVERY_SEALED_ENVELOPE_PAIR_V1"},
    "frozen_tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "frozen_authority_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "frozen_baseline_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "input_bundle_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "blind_execution_policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prepared_at":{"type":"string","format":"date-time"},
    "prepared_by":{"type":"string","minLength":1},
    "prepared_before_any_result":{"const":true},
    "results_present_at_prepare":{"const":false},
    "envelopes":{
      "type":"object",
      "required":["INDEPENDENT-SATURATION-A","INDEPENDENT-SATURATION-B"],
      "properties":{
        "INDEPENDENT-SATURATION-A":{"$ref":"#/$defs/envelope"},
        "INDEPENDENT-SATURATION-B":{"$ref":"#/$defs/envelope"}
      },
      "additionalProperties":false
    },
    "pair_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "final_claim_allowed":{"const":false}
  },
  "$defs":{
    "envelope":{
      "type":"object",
      "required":["wave_id","envelope_id","envelope_digest","workspace_seed","read_only_frozen_bundle","repository_browsing_allowed","opposite_wave_result_mounted","result_present_at_prepare","allowed_input_population"],
      "properties":{
        "wave_id":{"enum":["INDEPENDENT-SATURATION-A","INDEPENDENT-SATURATION-B"]},
        "envelope_id":{"type":"string","minLength":1},
        "envelope_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "workspace_seed":{"type":"string","minLength":1},
        "read_only_frozen_bundle":{"const":true},
        "repository_browsing_allowed":{"const":false},
        "opposite_wave_result_mounted":{"const":false},
        "result_present_at_prepare":{"const":false},
        "allowed_input_population":{"type":"array","minItems":3,"items":{"type":"string","minLength":1},"uniqueItems":true}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
