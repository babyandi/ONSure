{
  "openapi": "3.1.0",
  "info": {
    "title": "ONSure Local API",
    "version": "1.0.0",
    "description": "Loopback-only, bearer-authenticated ONSure API. Responses are nonfinal and never grant Production GO or Final PASS."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:47311",
      "description": "Default loopback runtime"
    }
  ],
  "tags": [
    {"name": "Runtime"},
    {"name": "Workflow"},
    {"name": "Evidence"},
    {"name": "Management"},
    {"name": "Control"}
  ],
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": ["Runtime"],
        "summary": "Return this OpenAPI 3.1 document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/vnd.oai.openapi+json": {
                "schema": {"type": "object"}
              }
            }
          },
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Runtime"],
        "summary": "Read loopback runtime health",
        "security": [],
        "responses": {
          "200": {
            "description": "Runtime is serving requests",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}
            }
          },
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "tags": ["Runtime"],
        "summary": "Read nonfinal capability status",
        "responses": {
          "200": {
            "description": "Capability status",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/StatusResponse"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/workflow": {
      "post": {
        "operationId": "dispatchWorkflow",
        "tags": ["Workflow"],
        "summary": "Dispatch an explicitly named local workflow operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRequest"}}
          }
        },
        "responses": {
          "200": {
            "description": "Workflow result",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/WorkflowResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/program-profile": {
      "post": {
        "operationId": "createProgramProfile",
        "tags": ["Workflow"],
        "summary": "Compatibility endpoint for program.learn",
        "requestBody": {"$ref": "#/components/requestBodies/JsonObject"},
        "responses": {
          "200": {"$ref": "#/components/responses/CompatibilityResult"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/validate": {
      "post": {
        "operationId": "runValidation",
        "tags": ["Workflow"],
        "summary": "Compatibility endpoint for validation.run",
        "requestBody": {"$ref": "#/components/requestBodies/JsonObject"},
        "responses": {
          "200": {"$ref": "#/components/responses/CompatibilityResult"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/run-artifact": {
      "post": {
        "operationId": "readRunArtifact",
        "tags": ["Evidence"],
        "summary": "Read a bounded JSON artifact under the registered workspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/RunArtifactRequest"}}
          }
        },
        "responses": {
          "200": {
            "description": "Digest-bound artifact",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/RunArtifactResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/workspace-snapshot": {
      "post": {
        "operationId": "getWorkspaceSnapshot",
        "tags": ["Evidence"],
        "summary": "Read the registered project and target runtime snapshot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceSnapshotRequest"}}
          }
        },
        "responses": {
          "200": {
            "description": "Workspace snapshot",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/SnapshotResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/management-overview": {
      "get": {
        "operationId": "getManagementOverview",
        "tags": ["Management"],
        "summary": "Project actual Gateway, program validation and improvement state for the local admin UI",
        "responses": {
          "200": {
            "description": "Read-only management projection",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ManagementOverviewResponse"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/autopilot-control": {
      "post": {
        "operationId": "controlAutopilot",
        "tags": ["Control"],
        "summary": "Request a bounded Autopilot control transition",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/AutopilotControlRequest"}}
          }
        },
        "responses": {
          "200": {
            "description": "Control receipt",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ControlResponse"}}
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/Busy"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "getLocalSession",
        "tags": ["Management"],
        "summary": "Return the authenticated local actor and immutable role",
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/programs": {
      "get": {
        "operationId": "listPrograms",
        "tags": ["Management"],
        "summary": "List registered programs and their latest validation projection",
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "operationId": "registerReadOnlyProgram",
        "tags": ["Management"],
        "summary": "Register an existing source directory without modifying it",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramRegistrationRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/v1/programs/validate": {
      "post": {
        "operationId": "validateReadOnlyProgramSnapshot",
        "tags": ["Management"],
        "summary": "Inspect or build an isolated bounded source snapshot and record nonfinal evidence",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramValidationRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/v1/programs/understand": {
      "post": {
        "operationId": "inferProgramUnderstanding",
        "tags": ["Management"],
        "summary": "Infer review-only business flows and E2E plan candidates from a registered immutable source",
        "description": "Inference does not execute target code, earn validation points, or grant PASS.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramUnderstandingRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/programs/understand/reviews": {
      "post": {
        "operationId": "reviewProgramUnderstanding",
        "tags": ["Management"],
        "summary": "Bind non-secret customer answers to an exact Program Understanding profile",
        "description": "Produces a review-bound E2E draft only. Approval and execution remain NOT_RUN.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramUnderstandingReviewRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/programs/understand/approval-requests": {
      "get": {
        "operationId": "listProgramUnderstandingApprovalRequests", "tags": ["Management"],
        "responses": {"200": {"$ref": "#/components/responses/GenericObject"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}
      },
      "post": {
        "operationId": "requestProgramUnderstandingApproval", "tags": ["Management"],
        "summary": "Request time-bounded distinct approval for an exact understanding review",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramUnderstandingApprovalRequest"}}}},
        "responses": {"200": {"$ref": "#/components/responses/GenericObject"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "405": {"$ref": "#/components/responses/MethodNotAllowed"}}
      }
    },
    "/v1/programs/understand/approval-decisions": {
      "post": {
        "operationId": "decideProgramUnderstandingApproval", "tags": ["Management"],
        "summary": "Approve or reject without executing the reviewed E2E draft",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgramUnderstandingApprovalDecision"}}}},
        "responses": {"200": {"$ref": "#/components/responses/GenericObject"}, "400": {"$ref": "#/components/responses/InvalidRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "405": {"$ref": "#/components/responses/MethodNotAllowed"}}
      }
    },
    "/v1/validation-scorecards": {
      "get": {
        "operationId": "listValidationScorecards",
        "tags": ["Management"],
        "summary": "List customer-facing digest-bound scorecards and consecutive-run comparisons",
        "description": "Scores measure self-validation evidence coverage and never grant final assurance.",
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/v1/gateway-settings/requests": {
      "get": {
        "operationId": "listGatewaySettingRequests",
        "tags": ["Management"],
        "summary": "List current Gateway settings and content-free change requests",
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "operationId": "requestGatewaySettingChange",
        "tags": ["Management"],
        "summary": "Create a secret-free Gateway setting change request; does not apply it",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GatewaySettingRequest"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/v1/gateway-settings/approvals": {
      "post": {
        "operationId": "decideGatewaySettingRequest",
        "tags": ["Management"],
        "summary": "Approve or reject using a distinct APPROVER identity; automatic apply remains disabled",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GatewaySettingApproval"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/v1/audit-events": {
      "get": {
        "operationId": "listManagementAuditEvents",
        "tags": ["Evidence"],
        "summary": "Return the bounded append-only management audit projection",
        "responses": {
          "200": {"$ref": "#/components/responses/GenericObject"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    }
  },
  "security": [{"bearerAuth": []}],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque local token",
        "description": "32-4096 character token stored only in the local runtime secret file."
      }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {"schema": {"type": "object", "additionalProperties": true}}
        }
      }
    },
    "responses": {
      "GenericObject": {
        "description": "Nonfinal local management result",
        "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}
      },
      "CompatibilityResult": {
        "description": "Compatibility workflow result",
        "content": {
          "application/json": {"schema": {"$ref": "#/components/schemas/CompatibilityResponse"}}
        }
      },
      "InvalidRequest": {
        "description": "Request failed validation",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      },
      "Unauthorized": {
        "description": "Bearer token is missing or invalid",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      },
      "Forbidden": {
        "description": "Client, browser origin or authenticated role is outside the required trust boundary",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      },
      "MethodNotAllowed": {
        "description": "HTTP method is not supported by the path",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      },
      "Busy": {
        "description": "Four local authenticated requests are already active",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      },
      "InternalError": {
        "description": "Safe internal error without secret or stack-trace disclosure",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      }
    },
    "schemas": {
      "ProgramRegistrationRequest": {
        "type": "object",
        "required": ["workspace_id", "workspace_name", "project_id", "project_name", "target_id", "target_name", "target_type", "source_root"],
        "properties": {
          "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "workspace_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "project_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "target_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "target_type": {"type": "string", "enum": ["GENERAL_SOFTWARE", "AI_APPLICATION", "AI_AGENTIC_PLATFORM"]},
          "source_root": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "ProgramValidationRequest": {
        "type": "object",
        "required": ["project_id", "target_id", "profile"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "profile": {"type": "string", "enum": ["UNIVERSAL", "INSPECT_ONLY", "MAVEN_STANDARD"]},
          "environment_profile_file": {
            "type": "string",
            "minLength": 1,
            "description": "Optional workspace-contained ONSURE_ENVIRONMENT_REQUIREMENT_PROFILE_V1 file used only by UNIVERSAL."
          },
          "execution_profile_file": {
            "type": "string",
            "minLength": 1,
            "description": "Optional workspace-contained, exact-source-bound ONSURE_REVIEWED_EXECUTION_PROFILE_V1 file used only by UNIVERSAL."
          }
        },
        "additionalProperties": false
      },
      "ProgramUnderstandingRequest": {
        "type": "object",
        "required": ["project_id", "target_id"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
        },
        "additionalProperties": false
      },
      "ProgramUnderstandingReviewRequest": {
        "type": "object",
        "required": ["project_id", "target_id", "profile_file_sha256", "answers"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "profile_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "answers": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["question_id", "answer_state"],
              "properties": {
                "question_id": {"type": "string", "pattern": "^[A-Z0-9_]{1,128}$"},
                "answer_state": {"type": "string", "enum": ["CONFIRMED", "UNAVAILABLE", "REJECTED"]},
                "evidence_reference_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "ProgramUnderstandingApprovalRequest": {
        "type": "object",
        "required": ["project_id", "target_id", "profile_file_sha256", "review_sha256", "reason", "ttl_seconds"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "profile_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 3600}
        }, "additionalProperties": false
      },
      "ProgramUnderstandingApprovalDecision": {
        "type": "object", "required": ["request_id", "decision", "reason"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^program-understanding-approval-[0-9a-f-]{36}$"},
          "decision": {"type": "string", "enum": ["APPROVE", "REJECT"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }, "additionalProperties": false
      },
      "GatewaySettingRequest": {
        "type": "object",
        "required": ["provider", "model", "requests_per_second", "cost_per_token_micros", "reason"],
        "properties": {
          "provider": {"type": "string", "enum": ["local-mock", "openai"]},
          "model": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,160}$"},
          "requests_per_second": {"type": "integer", "minimum": 1, "maximum": 10000},
          "cost_per_token_micros": {"type": "integer", "minimum": 0, "maximum": 1000000000},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      },
      "GatewaySettingApproval": {
        "type": "object",
        "required": ["request_id", "decision", "reason"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^gateway-setting-[0-9a-f-]{36}$"},
          "decision": {"type": "string", "enum": ["APPROVE", "REJECT"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": ["contract", "state", "binding", "assurance_class", "final_claim_allowed"],
        "properties": {
          "contract": {"const": "ONSURE_LOCAL_AUTHENTICATED_API_V1"},
          "state": {"const": "RUNNING"},
          "binding": {"const": "127.0.0.1"},
          "assurance_class": {"const": "SELF_VALIDATION_NONFINAL"},
          "final_claim_allowed": {"const": false}
        },
        "additionalProperties": false
      },
      "StatusResponse": {
        "type": "object",
        "required": ["contract", "state", "request_sequence", "workspace_root", "production_go", "commercial_go"],
        "properties": {
          "contract": {"const": "ONSURE_LOCAL_AUTHENTICATED_API_V1"},
          "state": {"const": "RUNNING"},
          "request_sequence": {"type": "integer", "minimum": 1},
