{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/hunk-approval-request.v1.schema.json",
  "title": "ONSure Hunk Approval Signing Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "request_id", "request_state", "receipt_contract", "approval_purpose",
    "patch_plan_id", "patch_plan_file", "patch_plan_file_sha256", "selected_hunk_ids",
    "branch_name", "allow_direct_main_write", "allow_force_push", "allow_merge",
    "created_at", "signer_must_supply", "final_claim_allowed"
  ],
  "properties": {
    "contract": {"const": "ONSURE_HUNK_APPROVAL_REQUEST_V1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{3,200}$"},
    "request_state": {"const": "AWAITING_EXTERNAL_SIGNATURE"},
    "receipt_contract": {"const": "ONSURE_HUNK_APPROVAL_RECEIPT_V1"},
    "approval_purpose": {"const": "PATCH_HUNK_APPROVAL"},
    "patch_plan_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "patch_plan_file": {"type": "string", "minLength": 1},
    "patch_plan_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_hunk_ids": {
      "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
    },
    "branch_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,120}$"},
    "allow_direct_main_write": {"const": false},
    "allow_force_push": {"const": false},
    "allow_merge": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "signer_must_supply": {
      "type": "array", "minItems": 8, "uniqueItems": true,
      "items": {"enum": [
        "approval_id", "nonce", "actor", "key_id", "signature_algorithm",
        "signature", "approved_at", "expires_at"
      ]}
    },
    "final_claim_allowed": {"const": false}
  }
}
