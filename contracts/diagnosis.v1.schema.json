{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/diagnosis.v1.schema.json",
  "title": "ONSure Diagnosis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "diagnosis_id", "finding_id", "source_digest", "reproduction_steps",
    "first_failure_point", "causal_experiments", "direct_cause", "root_cause",
    "contributing_factors", "confidence", "evidence_refs", "state", "created_at"
  ],
  "properties": {
    "contract": {"const": "ONSURE_DIAGNOSIS_V1"},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reproduction_steps": {"type": "array", "items": {"type": "string"}},
    "first_failure_point": {"type": ["string", "null"]},
    "causal_experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment", "expected", "observed", "receipt_id", "supports_cause"],
        "properties": {
          "experiment": {"type": "string", "minLength": 1},
          "expected": {"type": "string"},
          "observed": {"type": "string"},
          "receipt_id": {"type": "string", "minLength": 1},
          "supports_cause": {"type": "boolean"}
        }
      }
    },
    "direct_cause": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "contributing_factors": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "state": {"enum": ["RCA_CANDIDATE", "RCA_CONFIRMED", "RCA_REJECTED", "HOLD"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "RCA_CONFIRMED"}}},
      "then": {
        "properties": {
          "reproduction_steps": {"minItems": 1},
          "first_failure_point": {"type": "string", "minLength": 1},
          "causal_experiments": {"minItems": 1},
          "evidence_refs": {"minItems": 2}
        }
      }
    }
  ]
}
