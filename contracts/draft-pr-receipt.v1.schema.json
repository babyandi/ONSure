{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/draft-pr-receipt.v1.schema.json",
  "title": "ONSure Draft PR Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "change_set_sha256", "delivery_approval_sha256", "approval_actor",
    "approval_key_id", "branch", "commit_sha", "remote", "remote_url_sha256",
    "base_branch", "draft_pr_url", "draft", "merge_authorized", "created_at",
    "final_claim_allowed", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_DRAFT_PR_RECEIPT_V1"},
    "change_set_sha256": {"$ref": "#/$defs/sha256"},
    "delivery_approval_sha256": {"$ref": "#/$defs/sha256"},
    "approval_actor": {"type": "string", "minLength": 1},
    "approval_key_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "remote": {"type": "string", "minLength": 1},
    "remote_url_sha256": {"$ref": "#/$defs/sha256"},
    "base_branch": {"type": "string", "minLength": 1},
    "draft_pr_url": {"type": "string", "pattern": "^https://"},
    "draft": {"const": true},
    "merge_authorized": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "final_claim_allowed": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}