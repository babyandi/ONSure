{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/execution-plan.v1.schema.json",
  "title": "ONSure Execution Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "plan_id", "target_id", "program_profile_id", "source_tree_sha256",
    "risk", "review_packs", "scenario_classes", "fixture_count", "resource_budget",
    "permissions", "stop_conditions", "approval", "created_at", "product_full_chain",
    "independent_assurance", "final_claim_allowed", "plan_sha256"
  ],
  "properties": {
    "contract": {"const": "ONSURE_EXECUTION_PLAN_V1"},
    "plan_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "program_profile_id": {"type": "string", "minLength": 1},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "level"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
      }
    },
    "review_packs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "scenario_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "fixture_count": {"type": "integer", "minimum": 0},
    "resource_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_seconds", "memory_limit_mb", "process_limit", "network_egress", "paid_service_allowed"],
      "properties": {
        "estimated_seconds": {"type": "integer", "minimum": 1},
        "memory_limit_mb": {"type": "integer", "minimum": 128},
        "process_limit": {"type": "integer", "minimum": 1},
        "network_egress": {"enum": ["DENY_BY_DEFAULT", "ALLOWLIST_ONLY"]},
        "paid_service_allowed": {"type": "boolean"}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["read_source", "execute_reviewed_fixtures", "write_run_evidence", "modify_target", "git_commit", "git_push", "merge"],
      "properties": {
        "read_source": {"type": "boolean"}, "execute_reviewed_fixtures": {"type": "boolean"},
        "write_run_evidence": {"type": "boolean"}, "modify_target": {"type": "boolean"},
        "git_commit": {"type": "boolean"}, "git_push": {"type": "boolean"}, "merge": {"type": "boolean"}
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "scope", "approver", "revocable"],
      "properties": {
        "state": {"enum": ["AUTO_APPROVED_DEVELOPMENT_NONFINAL", "AWAITING_USER_APPROVAL", "USER_APPROVED", "REVOKED"]},
        "scope": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "revocable": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "product_full_chain": {"enum": ["NOT_RUN", "PARTIAL", "PASS", "FAIL", "HOLD"]},
    "independent_assurance": {"enum": ["NOT_RUN", "PARTIAL", "PASS", "FAIL", "HOLD"]},
    "final_claim_allowed": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
