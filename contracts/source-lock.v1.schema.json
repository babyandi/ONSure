{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/source-lock.v1.schema.json",
  "title": "ONSURE Source Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest_contract",
    "commit_sha",
    "tree_sha256",
    "policy_sha256",
    "source_scope",
    "policy_scope",
    "untracked_files_blocked",
    "worktree_clean"
  ],
  "properties": {
    "digest_contract": {"const": "ONSURE_SOURCE_DIGEST_V1"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}|[0-9a-f]{64}$"},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_scope": {"const": "GIT_TRACKED_FILES_ONLY"},
    "policy_scope": {"const": "GIT_TRACKED_POLICY_FILES_ONLY"},
    "untracked_files_blocked": {"const": true},
    "worktree_clean": {"const": true}
  }
}
