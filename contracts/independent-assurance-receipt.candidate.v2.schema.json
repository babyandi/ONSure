{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.dev/contracts/independent-assurance-receipt.candidate.v2.schema.json",
  "title":"ONSure Independent Assurance Receipt Candidate v2",
  "type":"object",
  "additionalProperties":false,
  "required":["contract","receipt_id","lane","target_id","target_digest","source_tree_sha256","evidence_bundle_sha256","principal_profile_sha256","independence_profile_sha256","qualification_receipt_sha256","freshness_receipt_sha256","oracle_set_digest","validator_set_digest","decision","reason_codes","executed_at","signature","receipt_sha256","assurance_class","final_claim_allowed"],
  "properties":{
    "contract":{"const":"ONSURE_INDEPENDENT_ASSURANCE_RECEIPT_V2_CANDIDATE"},
    "receipt_id":{"type":"string","minLength":1},
    "lane":{"enum":["OTESTER","OAUDIT"]},
    "target_id":{"type":"string","minLength":1},
    "target_digest":{"$ref":"#/$defs/sha256"},
    "source_tree_sha256":{"$ref":"#/$defs/sha256"},
    "evidence_bundle_sha256":{"$ref":"#/$defs/sha256"},
    "principal_profile_sha256":{"$ref":"#/$defs/sha256"},
    "independence_profile_sha256":{"$ref":"#/$defs/sha256"},
    "qualification_receipt_sha256":{"$ref":"#/$defs/sha256"},
    "freshness_receipt_sha256":{"$ref":"#/$defs/sha256"},
    "oracle_set_digest":{"$ref":"#/$defs/sha256"},
    "validator_set_digest":{"$ref":"#/$defs/sha256"},
    "decision":{"enum":["PASS","FAIL","BLOCKED","HOLD","INCONCLUSIVE"]},
    "reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "executed_at":{"type":"string","format":"date-time"},
    "signature":{"type":"object","additionalProperties":false,"required":["key_id","algorithm","signature"],"properties":{"key_id":{"type":"string","minLength":1},"algorithm":{"const":"Ed25519"},"signature":{"type":"string","minLength":32}}},
    "receipt_sha256":{"$ref":"#/$defs/sha256"},
    "assurance_class":{"enum":["INDEPENDENT_VERIFICATION","INDEPENDENT_AUDIT"]},
    "final_claim_allowed":{"const":false}
  },
  "allOf":[
    {"if":{"properties":{"lane":{"const":"OTESTER"}}},"then":{"properties":{"assurance_class":{"const":"INDEPENDENT_VERIFICATION"}}}},
    {"if":{"properties":{"lane":{"const":"OAUDIT"}}},"then":{"properties":{"assurance_class":{"const":"INDEPENDENT_AUDIT"}}}}
  ],
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
