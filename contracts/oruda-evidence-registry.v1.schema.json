{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.local/contracts/oruda-evidence-registry.v1.schema.json",
  "title": "ONSURE ORUDA Evidence Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "registry_id",
    "target_id",
    "job_id",
    "generated_at",
    "source_tree_sha256",
    "policy_digest",
    "regression_lock_digest",
    "rows"
  ],
  "properties": {
    "contract": {"const": "ONSURE_ORUDA_EVIDENCE_REGISTRY_V1"},
    "registry_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "regression_lock_digest": {"$ref": "#/$defs/sha256"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "typedStatus": {
      "type": "string",
      "enum": [
        "EXPECTED_PASS",
        "EXPECTED_FAIL",
        "UNEXPECTED_PASS",
        "UNEXPECTED_FAIL",
        "HARNESS_ERROR",
        "SKIPPED",
        "NOT_RUN",
        "INCONCLUSIVE"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_record_id",
        "failure_id",
        "fixture_id",
        "variant_type",
        "severity",
        "primary_owner",
        "secondary_guard",
        "final_guard",
        "oracle_id",
        "harness_id",
        "input_hash",
        "source_hash",
        "policy_digest",
        "receipt_digest",
        "raw_log_hash",
        "run_id",
        "run_number",
        "expected_result",
        "actual_result",
        "verdict",
        "rca_id",
        "fix_ref",
        "regression_run_1",
        "regression_run_2",
        "blind_review_id",
        "lock_status"
      ],
      "properties": {
        "evidence_record_id": {"type": "string", "minLength": 1},
        "failure_id": {"type": "string", "minLength": 1},
        "fixture_id": {"type": "string", "minLength": 1},
        "variant_type": {
          "type": "string",
          "enum": ["POSITIVE", "NEGATIVE", "HANDOFF", "QUALITY", "EVIDENCE"]
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "primary_owner": {"type": "string", "minLength": 1},
        "secondary_guard": {"type": "string", "minLength": 1},
        "final_guard": {"type": "string", "minLength": 1},
        "oracle_id": {"type": "string", "minLength": 1},
        "harness_id": {"type": "string", "minLength": 1},
        "input_hash": {"$ref": "#/$defs/sha256"},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "receipt_digest": {"$ref": "#/$defs/sha256"},
        "raw_log_hash": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1},
        "run_number": {"type": "integer", "minimum": 1},
        "expected_result": {"type": "string"},
        "actual_result": {"type": "string"},
        "verdict": {"$ref": "#/$defs/typedStatus"},
        "rca_id": {"type": "string", "minLength": 1},
        "fix_ref": {"type": "string", "minLength": 1},
        "regression_run_1": {"$ref": "#/$defs/typedStatus"},
        "regression_run_2": {"$ref": "#/$defs/typedStatus"},
        "blind_review_id": {"type": "string", "minLength": 1},
        "lock_status": {
          "type": "string",
          "enum": [
            "OPEN",
            "BLOCKED",
            "RCA_REQUIRED",
            "REGRESSION_REQUIRED",
            "BLIND_REVIEW_REQUIRED",
            "LOCK_CANDIDATE"
          ]
        }
      }
    }
  }
}
