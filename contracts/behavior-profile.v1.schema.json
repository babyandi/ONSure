{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsure.dev/contracts/behavior-profile.v1.schema.json",
  "title": "ONSure Behavior Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "profile_id", "program_profile_id", "source_baseline_hash",
    "runtime_context", "observations", "variability", "failure_conditions",
    "policy_violations", "evidence_refs", "state"
  ],
  "properties": {
    "contract": {"const": "ONSURE_BEHAVIOR_PROFILE_V1"},
    "profile_id": {"type": "string", "minLength": 1},
    "program_profile_id": {"type": "string", "minLength": 1},
    "source_baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_id", "execution_profile", "model_id", "model_version",
        "prompt_digest", "tool_registry_digest", "environment_digest"
      ],
      "properties": {
        "harness_id": {"type": "string", "minLength": 1},
        "execution_profile": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "prompt_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|NOT_AVAILABLE)$"},
        "tool_registry_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|NOT_AVAILABLE)$"},
        "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id", "iteration", "input_digest", "output_digest", "tool_calls",
          "decision", "duration_ms", "run_receipt_id"
        ],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "iteration": {"type": "integer", "minimum": 1},
          "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tool_calls": {"type": "array", "items": {"type": "string"}},
          "decision": {"enum": ["PASS", "FAIL", "BLOCKED", "HOLD", "NOT_RUN", "INCONCLUSIVE"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "run_receipt_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "variability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_run_count", "scenario_count", "distinct_output_count", "unstable_scenarios", "stable"],
      "properties": {
        "repeated_run_count": {"type": "integer", "minimum": 1},
        "scenario_count": {"type": "integer", "minimum": 1},
        "distinct_output_count": {"type": "integer", "minimum": 1},
        "unstable_scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "stable": {"type": "boolean"}
      }
    },
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "policy_violations": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "state": {"enum": ["BEHAVIOR_CANDIDATE", "BEHAVIOR_VERIFIED", "BEHAVIOR_ACTIVE", "STALE", "HOLD"]}
  }
}
