{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://onsure.local/harness/universal-v1/evidence.v1.schema.json",
  "title":"ONSURE Universal Evidence v1",
  "type":"object",
  "additionalProperties":false,
  "required":["contract","evidence_id","run_id","fixture_id","axis_ids","command","cwd","started_at","completed_at","exit_code","timed_out","stdout_sha256","stderr_sha256","environment_sha256","decision"],
  "properties":{
    "contract":{"const":"ONSURE_UNIVERSAL_EVIDENCE_V1"},
    "evidence_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "fixture_id":{"type":"string","minLength":1},
    "axis_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "command":{"type":"array","items":{"type":"string"}},
    "cwd":{"type":"string"},
    "started_at":{"type":"string","format":"date-time"},
    "completed_at":{"type":"string","format":"date-time"},
    "exit_code":{"type":["integer","null"]},
    "timed_out":{"type":"boolean"},
    "stdout_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stderr_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "environment_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decision":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN"]},
    "reason":{"type":"string"}
  }
}
